{
  "week": "GMP01",
  "prefix": "tg01",
  "lecture": "01 완제 PDF",
  "terms": [
    {"no": 1, "term": "완제의약품 (Drug Product)", "group": "basic", "def": "주성분에 부형제를 더해 환자가 실제로 쓰는 최종 형태의 약.", "src": "01 완제의약품 제조 공정 PDF p.4"},
    {"no": 2, "term": "API (Active Pharmaceutical Ingredient)", "group": "basic", "def": "약효를 나타내는 주성분.", "src": "01 완제의약품 제조 공정 PDF p.10–11"},
    {"no": 3, "term": "부형제 (Excipient)", "group": "basic", "def": "약효 없이 안정성·사용성을 높이려고 주성분과 함께 넣는 물질.", "src": "01 완제의약품 제조 공정 PDF p.10"},
    {"no": 4, "term": "제형 (Dosage form)", "group": "basic", "def": "정제·주사제처럼 투여하기 알맞게 만든 약의 형태.", "src": "01 완제의약품 제조 공정 PDF p.4, p.9"},
    {"no": 5, "term": "경구 고형제", "group": "form", "def": "정제·캡슐처럼 입으로 먹는 고체 형태의 약.", "src": "01 완제의약품 제조 공정 PDF p.4"},
    {"no": 6, "term": "액제 · 시럽", "group": "form", "def": "점안제·내용 액제처럼 용액 상태로 쓰는 약.", "src": "01 완제의약품 제조 공정 PDF p.4"},
    {"no": 7, "term": "외용제", "group": "form", "def": "연고·패치처럼 피부나 점막에 바르거나 붙이는 약.", "src": "01 완제의약품 제조 공정 PDF p.4"},
    {"no": 8, "term": "주사제", "group": "form", "def": "혈관·근육에 직접 넣어 무균이 절대 기준인 약.", "src": "01 완제의약품 제조 공정 PDF p.4, p.7"},
    {"no": 9, "term": "최종멸균법 (Terminal sterilization)", "group": "steril", "def": "용기에 담아 밀봉한 뒤 용기째 열로 멸균하는 방법.", "src": "01 완제의약품 제조 공정 PDF p.7"},
    {"no": 10, "term": "무균조작법 (Aseptic processing)", "group": "steril", "def": "열에 약한 약을 무균 여과해 무균 환경에서 충전하는 방법.", "src": "01 완제의약품 제조 공정 PDF p.7"},
    {"no": 11, "term": "SAL (Sterility Assurance Level)", "group": "steril", "def": "멸균 후 미생물이 살아 있을 확률(주사제는 10⁻⁶ 이하).", "src": "01 완제의약품 제조 공정 PDF p.7"},
    {"no": 12, "term": "무균 여과 (Sterile filtration)", "group": "steril", "def": "0.2 µm 급 필터로 용액을 걸러 미생물을 없애는 것.", "src": "01 완제의약품 제조 공정 PDF p.13"},
    {"no": 13, "term": "필터 완전성 시험 (Filter integrity test)", "group": "steril", "def": "필터가 손상 없이 제 성능을 내는지 사용 전·후에 확인하는 시험.", "src": "01 완제의약품 제조 공정 PDF p.13"},
    {"no": 14, "term": "혼합 (Compounding)", "group": "comp", "def": "주성분과 부형제를 정확한 비율로 섞어 균일한 약액을 만드는 공정.", "src": "01 완제의약품 제조 공정 PDF p.9"},
    {"no": 15, "term": "칭량 (Weighing)", "group": "comp", "def": "원료를 확인하고 정해진 양을 정확히 다는 단계.", "src": "01 완제의약품 제조 공정 PDF p.12"},
    {"no": 16, "term": "과교반 (Over-agitation)", "group": "comp", "def": "너무 세게·오래 섞어 거품과 단백질 변성이 생기는 것.", "src": "01 완제의약품 제조 공정 PDF p.12–13"},
    {"no": 17, "term": "Hold time (보관 허용 시간)", "group": "comp", "def": "조제 후 다음 공정까지 보관할 수 있는 최대 시간.", "src": "01 완제의약품 제조 공정 PDF p.12–13"},
    {"no": 18, "term": "함량 균일성", "group": "comp", "def": "어느 부분을 떠도 주성분 양이 같은 상태.", "src": "01 완제의약품 제조 공정 PDF p.6"},
    {"no": 19, "term": "완충제 (Buffer)", "group": "exc", "def": "산·염기가 들어와도 pH가 크게 변하지 않게 버티는 부형제.", "src": "01 완제의약품 제조 공정 PDF p.11"},
    {"no": 20, "term": "pH 조절제 (pH adjuster)", "group": "exc", "def": "pH를 목표값으로 맞추려고 넣는 산·염기.", "src": "01 완제의약품 제조 공정 PDF p.11", "drop": true},
    {"no": 21, "term": "보존제 (Preservative)", "group": "exc", "def": "사용 중 미생물이 자라지 않게 넣는 부형제.", "src": "01 완제의약품 제조 공정 PDF p.11"},
    {"no": 22, "term": "안정화제 (Stabilizer)", "group": "exc", "def": "단백질이 변성·응집되지 않게 지켜 주는 부형제.", "src": "01 완제의약품 제조 공정 PDF p.11"},
    {"no": 23, "term": "충전 (Filling)", "group": "fill", "def": "제품을 정해진 양만큼 용기에 담는 공정.", "src": "01 완제의약품 제조 공정 PDF p.16"},
    {"no": 24, "term": "바이알 (Vial)", "group": "cont", "def": "고무마개를 끼우고 알루미늄 캡으로 밀봉하는 유리병.", "src": "01 완제의약품 제조 공정 PDF p.16–17"},
    {"no": 25, "term": "앰플 (Ampoule)", "group": "cont", "def": "유리 끝을 불로 녹여 붙여 밀봉하는 유리 용기.", "src": "01 완제의약품 제조 공정 PDF p.16–17"},
    {"no": 26, "term": "프리필드 시린지 (PFS)", "group": "cont", "def": "약을 미리 채워 바로 주사할 수 있게 만든 주사기.", "src": "01 완제의약품 제조 공정 PDF p.16–17"},
    {"no": 27, "term": "백 (Bag)", "group": "cont", "def": "포트가 달린 말랑한 플라스틱 용기(수액 등).", "src": "01 완제의약품 제조 공정 PDF p.17"},
    {"no": 28, "term": "알루미늄 캡핑 (Crimping)", "group": "fill", "def": "바이알 고무마개 위를 금속 캡으로 말아 눌러 고정하는 단계.", "src": "01 완제의약품 제조 공정 PDF p.16"},
    {"no": 29, "term": "반마개 (Partial stoppering)", "group": "fill", "def": "동결건조 중 수증기가 빠지도록 고무마개를 덜 끼운 상태.", "src": "01 완제의약품 제조 공정 PDF p.16"},
    {"no": 30, "term": "동결건조 (Lyophilization)", "group": "fill", "def": "얼린 뒤 압력을 낮춰 얼음을 수증기로 날려 말리는 공정.", "src": "01 완제의약품 제조 공정 PDF p.16"},
    {"no": 31, "term": "CCI (Container Closure Integrity)", "group": "qc", "def": "용기와 마개가 새지 않고 미생물을 막을 만큼 밀봉된 상태.", "src": "01 완제의약품 제조 공정 PDF p.19"},
    {"no": 32, "term": "전수검사 (100 % inspection)", "group": "qc", "def": "충전한 모든 용기를 하나하나 검사해 불량품을 빼는 것.", "src": "01 완제의약품 제조 공정 PDF p.19"},
    {"no": 33, "term": "IPC 중량검사", "group": "qc", "def": "충전 중 용기 무게로 충전량이 규격 안인지 확인하는 시험.", "src": "01 완제의약품 제조 공정 PDF p.19, p.21"},
    {"no": 34, "term": "과충전 / 미충전", "group": "qc", "def": "충전량이 규격보다 많거나 적은 불량.", "src": "01 완제의약품 제조 공정 PDF p.21"},
    {"no": 35, "term": "Grade A (충전 지점)", "group": "env", "def": "무균 충전이 일어나는 가장 엄격한 청정 구역.", "src": "01 완제의약품 제조 공정 PDF p.18"},
    {"no": 36, "term": "Grade B (배후 공간)", "group": "env", "def": "무균 충전 구역을 둘러싼 배경 청정 구역.", "src": "01 완제의약품 제조 공정 PDF p.18"},
    {"no": 37, "term": "환경 모니터링 (EM)", "group": "env", "def": "부유입자·부유균·낙하균·차압을 계속 재서 청정 상태를 감시하는 활동.", "src": "01 완제의약품 제조 공정 PDF p.18"},
    {"no": 38, "term": "미디어 필 (Media fill)", "group": "env", "def": "제품 대신 배지를 충전해 무균 작업에 오염이 없는지 확인하는 시험.", "src": "01 완제의약품 제조 공정 PDF p.18"},
    {"no": 39, "term": "무균 갱의 (Aseptic gowning)", "group": "env", "def": "무균 구역에 들어가기 전 정해진 절차로 무균복을 입는 것.", "src": "01 완제의약품 제조 공정 PDF p.18"},
    {"no": 40, "term": "Batch Record (제조기록서)", "group": "gmp", "def": "배치마다 누가 언제 무엇을 어떻게 했는지 적은 문서.", "src": "01 완제의약품 제조 공정 PDF p.6"},
    {"no": 41, "term": "교차오염 (Cross-contamination)", "group": "gmp", "def": "다른 제품·물질이 섞여 들어가 오염되는 것.", "src": "01 완제의약품 제조 공정 PDF p.6"},
    {"no": 42, "term": "출하승인 (Release)", "group": "gmp", "def": "시험 결과와 기록을 검토해 제품을 시장에 내보내도 된다고 정하는 것.", "src": "01 완제의약품 제조 공정 PDF p.6"}
  ]
}
