{
  "week": "WK03",
  "prefix": "tw03",
  "lecture": "WK03 강의 녹음",
  "matchSealed": 49,
  "terms": [
    {"no": 1, "term": "Chromatography", "group": "basic", "def": "물질마다 레진에 머무는 시간이 다른 점을 이용해 혼합물을 나누는 방법.", "src": "WK03 강의 녹음 07:56–08:30"},
    {"no": 2, "term": "HPLC (고성능 액체 크로마토그래피)", "group": "basic", "def": "10 µm 이하 작은 비드와 높은 압력으로 정제 결과를 분석하는 장비.", "src": "WK03 강의 녹음 05:39–07:12, 24:19"},
    {"no": 3, "term": "Stationary phase (고정상)", "group": "basic", "def": "컬럼 안에 채워져 움직이지 않는 레진.", "src": "WK03 강의 녹음 15:01–17:36", "short": true},
    {"no": 4, "term": "Mobile phase (이동상)", "group": "basic", "def": "컬럼을 따라 흐르며 시료를 옮기는 버퍼.", "src": "WK03 강의 녹음 15:01–17:36", "short": true},
    {"no": 5, "term": "Resin bead", "group": "basic", "def": "컬럼을 채우는 작은 알갱이 — 생산용은 보통 30~90 µm.", "src": "WK03 강의 녹음 25:20–27:48"},
    {"no": 6, "term": "Resolution (분리능)", "group": "basic", "def": "섞인 물질을 서로 얼마나 잘 나누는지의 정도.", "src": "WK03 강의 녹음 25:20–27:48"},
    {"no": 7, "term": "Fraction (분획)", "group": "basic", "def": "컬럼에서 나오는 용액을 시간 순서대로 나눠 받은 것.", "src": "WK03 강의 녹음 07:56–08:30, 37:18–39:56"},
    {"no": 8, "term": "Capture", "group": "step", "def": "배양액에서 목표 단백질을 처음 잡는 첫 정제 단계.", "src": "WK03 강의 녹음 29:54–31:11", "short": true, "answersExtra": ["포획", "캡처", "포획 단계"]},
    {"no": 9, "term": "Intermediate purification (중간 정제)", "group": "step", "def": "첫 단계 뒤에 남은 불순물을 더 줄이는 단계.", "src": "WK03 강의 녹음 29:54–31:11"},
    {"no": 10, "term": "Polishing", "group": "step", "def": "마지막에 남은 미량 불순물을 없애는 단계.", "src": "WK03 강의 녹음 29:54–31:11", "short": true, "answersExtra": ["폴리싱", "최종 정제 단계", "최종 정제"]},
    {"no": 11, "term": "Affinity chromatography (친화 크로마토그래피)", "group": "type", "def": "목표 물질에만 붙는 리간드로 한 번에 크게 정제하는 방법.", "src": "WK03 강의 녹음 11:32–13:36", "short": true, "answersExtra": ["Affinity", "친화"]},
    {"no": 12, "term": "IEX (Ion Exchange, 이온교환)", "group": "type", "def": "전하 차이로 레진에 결합시킨 뒤 염 농도를 올려 용출하는 방법.", "src": "WK03 강의 녹음 10:07", "short": true},
    {"no": 13, "term": "HIC (Hydrophobic Interaction Chromatography)", "group": "type", "def": "소수성(물을 싫어하는 성질) 차이로 붙여 나누는 방법.", "src": "WK03 강의 녹음 11:32–13:36, 36:31", "short": true, "answersExtra": ["소수성 상호작용 크로마토그래피", "소수성 크로마토그래피"]},
    {"no": 14, "term": "MMC (Multimodal Chromatography)", "group": "type", "def": "전하·소수성 등 여러 성질을 함께 써서 붙이는 레진.", "src": "WK03 강의 녹음 11:32–13:36"},
    {"no": 15, "term": "SEC (Size Exclusion, Gel filtration)", "group": "type", "def": "레진에 붙이지 않고 분자 크기로만 나누는 방법.", "src": "WK03 강의 녹음 14:25, 36:31", "short": true, "answersExtra": ["크기 배제 크로마토그래피", "겔 여과"]},
    {"no": 16, "term": "Ligand", "group": "type", "def": "레진에 고정되어 목표 물질과 결합하는 분자.", "src": "WK03 강의 녹음 33:05–36:20", "short": true, "answersExtra": ["리간드"]},
    {"no": 17, "term": "Bind-elute mode", "group": "mode", "def": "목표 물질을 레진에 결합시킨 뒤 용출해 회수하는 운전 방식.", "src": "WK03 강의 녹음 33:05–36:20", "short": true, "answersExtra": ["Bind-elute", "결합 용출 모드", "결합-용출 모드"]},
    {"no": 18, "term": "Flow-through mode", "group": "mode", "def": "불순물만 레진에 결합시키고 목표 물질은 통과시키는 운전 방식.", "src": "WK03 강의 녹음 33:05–36:20", "short": true, "answersExtra": ["Flow-through", "통과 모드", "플로우스루"]},
    {"no": 19, "term": "Binding capacity (결합 용량)", "group": "mode", "def": "레진에 결합할 수 있는 단백질의 최대량 — 목표량보다 넉넉해야 한다.", "src": "WK03 강의 녹음 33:05–36:20"},
    {"no": 20, "term": "Loading", "group": "mode", "def": "Low salt 조건에서 시료를 컬럼에 흘려 레진에 결합시키는 단계.", "src": "WK03 강의 녹음 10:07"},
    {"no": 21, "term": "Elution (용출)", "group": "mode", "def": "레진에 결합한 물질을 염 농도·pH 등을 바꿔 떨어뜨려 회수하는 것.", "src": "WK03 강의 녹음 10:07, 36:31", "short": true},
    {"no": 22, "term": "Linear gradient", "group": "mode", "def": "염 농도를 일정하게 조금씩 올려 전체 패턴을 보는 용출.", "src": "WK03 강의 녹음 37:18–39:56"},
    {"no": 23, "term": "Step elution", "group": "mode", "def": "염 농도를 2~3단계로 한 번에 바꾸는 단순한 용출.", "src": "WK03 강의 녹음 37:18–39:56"},
    {"no": 24, "term": "Gradient mixer (믹서)", "group": "system", "def": "펌프 A·B의 두 버퍼를 섞어 원하는 염 농도를 만드는 장치.", "src": "WK03 강의 녹음 18:54–23:07", "drop": true},
    {"no": 25, "term": "Air trap (에어 트랩)", "group": "system", "def": "컬럼에 공기가 들어가지 않게 기포를 잡는 장치.", "src": "WK03 강의 녹음 18:54–23:07", "drop": true},
    {"no": 26, "term": "Pressure sensor (압력 센서)", "group": "system", "def": "막힘을 알려 주는 계기 — 값이 너무 높으면 바로 멈춘다.", "src": "WK03 강의 녹음 18:54–23:07", "drop": true},
    {"no": 27, "term": "UV 280 nm", "group": "system", "def": "단백질 양을 보는 자외선 흡광 파장.", "src": "WK03 강의 녹음 15:01–17:36"},
    {"no": 28, "term": "UV 260 nm", "group": "system", "def": "핵산(DNA·RNA) 양을 보는 자외선 흡광 파장.", "src": "WK03 강의 녹음 15:01–17:36"},
    {"no": 29, "term": "Conductivity (전도도)", "group": "system", "def": "용액에 녹은 염의 농도를 나타내는 값.", "src": "WK03 강의 녹음 15:01–17:36"},
    {"no": 30, "term": "Fraction collector (분획 수집기)", "group": "system", "def": "컬럼에서 나오는 용액을 튜브에 나눠 받는 장치.", "src": "WK03 강의 녹음 18:54–23:07", "drop": true},
    {"no": 31, "term": "Bradford·Lowry·BCA assay", "group": "analysis", "def": "정제한 단백질의 농도를 재는 방법들.", "src": "WK03 강의 녹음 40:25–41:40"},
    {"no": 32, "term": "SDS-PAGE", "group": "analysis", "def": "단백질을 크기별 띠(밴드)로 나눠 순도를 보는 전기영동.", "src": "WK03 강의 녹음 40:25–41:40"},
    {"no": 33, "term": "Western blot", "group": "analysis", "def": "항체로 특정 단백질이 있는지 확인하는 방법.", "src": "WK03 강의 녹음 40:25–41:40"},
    {"no": 34, "term": "ELISA", "group": "analysis", "def": "항체 반응으로 특정 단백질의 양을 재는 방법.", "src": "WK03 강의 녹음 40:25–41:40"},
    {"no": 35, "term": "Desalting (탈염)", "group": "sec", "def": "염·작은 분자를 빼고 버퍼를 바꾸는 보조 단계(다음 IEX 준비).", "src": "WK03 강의 녹음 42:18–42:56", "short": true},
    {"no": 36, "term": "Group separation", "group": "sec", "def": "큰 분자와 작은 분자를 두 무리로 거칠게 나누는 SEC.", "src": "WK03 강의 녹음 56:26–58:33"},
    {"no": 37, "term": "Sephadex G-25", "group": "sec", "def": "단백질은 배제되고 염만 구멍에 들어가는 탈염용 레진.", "src": "WK03 강의 녹음 56:26–59:53", "drop": true},
    {"no": 38, "term": "Void volume (V0)", "group": "sec", "def": "Pore에 못 들어가는 가장 큰 분자가 먼저 나오는 부피.", "src": "WK03 강의 녹음 43:25–44:31"},
    {"no": 39, "term": "Total volume (Vt)", "group": "sec", "def": "가장 작은 분자가 마지막에 나오는 부피.", "src": "WK03 강의 녹음 43:25–44:31"},
    {"no": 40, "term": "Column volume (CV)", "group": "sec", "def": "컬럼 단면적 × 높이로 구하는 원통 부피.", "src": "WK03 강의 녹음 43:25–44:31"},
    {"no": 41, "term": "Fine fractionation (정밀 분획)", "group": "sec", "def": "크기가 비슷한 분자까지 나누는 SEC — 시료는 컬럼 부피의 약 2% 이하.", "src": "WK03 강의 녹음 45:00–47:39", "drop": true},
    {"no": 42, "term": "Superdex Increase", "group": "sec", "def": "약 10 µm 작은 비드로 분리능이 높은 분석용 SEC 레진.", "src": "WK03 강의 녹음 51:08–52:03", "drop": true},
    {"no": 43, "term": "Superdex prep grade", "group": "sec", "def": "약 34 µm 비드의 생산용 SEC 레진.", "src": "WK03 강의 녹음 51:08–52:03", "drop": true},
    {"no": 44, "term": "Sephacryl S-100", "group": "sec", "def": "좁은 분자량 범위를 잘 나누는 SEC 레진.", "src": "WK03 강의 녹음 53:34–56:00", "drop": true},
    {"no": 45, "term": "Sephacryl S-400", "group": "sec", "def": "넓은 분자량 범위를 나누는 SEC 레진.", "src": "WK03 강의 녹음 53:34–56:00", "drop": true},
    {"no": 46, "term": "Swelling (팽윤)", "group": "prep", "def": "건조 레진을 물(버퍼)에 불려 부피를 키우는 것.", "src": "WK03 강의 녹음 59:53–1:00:49", "drop": true},
    {"no": 47, "term": "Packing (컬럼 충전)", "group": "prep", "def": "불린 레진을 컬럼에 고르게 채우는 작업.", "src": "WK03 강의 녹음 59:53–1:00:49", "drop": true},
    {"no": 48, "term": "Scale-up (랩 → 파일럿 → 생산)", "group": "prep", "def": "실험실 규모 조건을 수십~수백 배 큰 생산 규모로 옮기는 것.", "src": "WK03 강의 녹음 24:47", "drop": true},
    {"no": 49, "term": "Supply diversification (공급 다변화)", "group": "prep", "def": "한 회사에 의존하지 않도록 대체 공급사를 확보해 두는 것.", "src": "WK03 강의 녹음 48:02–50:33", "drop": true},
    {"no": 50, "term": "Analytical chromatography", "group": "purpose", "def": "혼합물 성분을 확인·정량하는 것이 목적인 크로마토그래피(예: HPLC).", "src": "WK03 교재 (1.3 분석용 vs 분취·생산용)"},
    {"no": 51, "term": "Preparative chromatography", "group": "purpose", "def": "원하는 분자를 분리·정제해 다음 공정에 쓰는 생산용 크로마토그래피.", "src": "WK03 교재 (1.3 분석용 vs 분취·생산용)"},
    {"no": 52, "term": "DSC (Differential Scanning Calorimetry)", "group": "analysis", "def": "정제한 단백질의 안정성을 보는 열분석 도구.", "src": "WK03 교재 (1.13 정제 후 분석·특성 평가)", "short": true, "answersExtra": ["DSC"]},
    {"no": 53, "term": "SPR (Surface Plasmon Resonance)", "group": "analysis", "def": "정제한 단백질의 결합 활성을 보는 분석 도구.", "src": "WK03 교재 (1.13 정제 후 분석·특성 평가)"},
    {"no": 54, "term": "Column housing", "group": "basic", "def": "고정상(레진)을 채워 넣는 컬럼 본체.", "src": "WK03 교재 (1.7 세 가지 구성 요소)"},
    {"no": 55, "term": "Retention time (RT)", "group": "basic", "def": "시료 성분이 컬럼에서 나오기까지 걸리는 시간 — 고정상과 강하게 상호작용할수록 길다.", "src": "WK03 교재 (1.5 컬럼 크로마토그래피의 원리)"},
    {"no": 56, "term": "Matrix (매트릭스)", "group": "basic", "def": "리간드를 고정하는 레진 비드의 바탕 물질 — 친수성·단단함이 필요하다.", "src": "WK03 교재 (1.14–1.15 레진과 이상적인 매트릭스)"},
    {"no": 57, "term": "Monolith", "group": "basic", "def": "입자가 아닌 한 덩어리의 다공성 구조로 된 고정상.", "src": "WK03 교재 (1.14 레진과 매트릭스)"},
    {"no": 58, "term": "Eluate (용출액)", "group": "mode", "def": "컬럼에서 빠져나오는 액체.", "src": "WK03 교재 (1.5 컬럼 크로마토그래피의 원리)"},
    {"no": 59, "term": "Isocratic elution", "group": "mode", "def": "버퍼 조건을 바꾸지 않고 같은 조건으로 계속 흘려 분리하는 용출.", "src": "WK03 교재 (1.11 용출)"},
    {"no": 60, "term": "SBC (Static Binding Capacity)", "group": "mode", "def": "비커에서 batch로 잰 레진의 총 결합 용량.", "src": "WK03 교재 (3.8 단백질 결합 용량)"},
    {"no": 61, "term": "Breakthrough (돌파)", "group": "mode", "def": "레진이 포화돼 결합하지 못한 목표 물질이 컬럼 밖으로 새어 나오는 것.", "src": "WK03 교재 (3.8 단백질 결합 용량)"},
    {"no": 62, "term": "Straight fractionation", "group": "frac", "def": "일정 부피마다 계속 나눠 받는 분획 방식.", "src": "WK03 교재 (1.12 분획 방식)"},
    {"no": 63, "term": "Peak fractionation", "group": "frac", "def": "Peak가 나올 때만 받는 분획 방식.", "src": "WK03 교재 (1.12 분획 방식)"},
    {"no": 64, "term": "Selectivity (선택성)", "group": "res", "def": "두 peak 사이가 얼마나 떨어져 있는지 — 분해능에 가장 중요한 요인.", "src": "WK03 교재 (1.17 선택성)", "short": true},
    {"no": 65, "term": "Efficiency (효율)", "group": "res", "def": "충진된 bed에서 좁고 대칭적인 peak로 용출시키는 능력.", "src": "WK03 교재 (1.18 효율)"},
    {"no": 66, "term": "Peak broadening", "group": "res", "def": "Peak가 넓게 퍼지는 현상 — bead size·packing·시료 부피·점도·유속이 영향을 준다.", "src": "WK03 교재 (1.18 효율)"},
    {"no": 67, "term": "Kav", "group": "sec", "def": "SEC 용출 위치를 0(가장 큰 분자)~1(가장 작은 분자)로 나타낸 값.", "src": "WK03 교재 (1.21 분획 범위와 Kav)"},
    {"no": 68, "term": "Exclusion limit (배제 한계)", "group": "sec", "def": "그보다 큰 분자는 pore에 전혀 못 들어가는 분자량 상한.", "src": "WK03 교재 (1.21 분획 범위와 Kav)"},
    {"no": 69, "term": "Fractionation range", "group": "sec", "def": "SEC 레진이 크기로 나눌 수 있는 분자량 범위.", "src": "WK03 교재 (1.21 분획 범위와 Kav)"},
    {"no": 70, "term": "Buffer exchange", "group": "sec", "def": "시료의 버퍼를 다른 버퍼로 바꾸는 것 — desalting과 함께 group separation으로 한다.", "src": "WK03 교재 (2.2–2.3 SEC의 목적, Desalting과 Buffer exchange)"},
    {"no": 71, "term": "Fine fractionation (정밀 분리)", "group": "sec", "def": "Monomer·dimer처럼 크기가 비슷한 분자까지 나누는 SEC.", "src": "WK03 교재 (2.2 SEC의 목적)"},
    {"no": 72, "term": "Strong ion exchanger", "group": "iex", "def": "pH 2~12의 넓은 범위에서 전하를 유지하는 이온교환기(Q, S).", "src": "WK03 교재 (3.2–3.3 강 vs 약 이온교환기)"},
    {"no": 73, "term": "Weak ion exchanger", "group": "iex", "def": "좁은 pH 범위에서만 전하를 띠고 다른 선택성을 주는 이온교환기(DEAE, CM).", "src": "WK03 교재 (3.2–3.3 강 vs 약 이온교환기)"},
