{
  "week": "WK03",
  "prefix": "tw03",
  "lecture": "WK03 강의 녹음",
  "terms": [
    {"no": 1, "term": "Chromatography (크로마토그래피)", "group": "basic", "def": "물질마다 레진에 머무는 시간이 다른 점을 이용해 혼합물을 나누는 방법.", "src": "WK03 강의 녹음 07:56–08:30"},
    {"no": 2, "term": "HPLC (고성능 액체 크로마토그래피)", "group": "basic", "def": "10 µm 이하 작은 비드와 높은 압력으로 정제 결과를 분석하는 장비.", "src": "WK03 강의 녹음 05:39–07:12, 24:19"},
    {"no": 3, "term": "Stationary phase (고정상)", "group": "basic", "def": "컬럼 안에 채워져 움직이지 않는 레진.", "src": "WK03 강의 녹음 15:01–17:36"},
    {"no": 4, "term": "Mobile phase (이동상)", "group": "basic", "def": "컬럼을 따라 흐르며 시료를 옮기는 버퍼.", "src": "WK03 강의 녹음 15:01–17:36"},
    {"no": 5, "term": "Resin bead (레진 비드)", "group": "basic", "def": "컬럼을 채우는 작은 알갱이 — 생산용은 보통 30~90 µm.", "src": "WK03 강의 녹음 25:20–27:48"},
    {"no": 6, "term": "Resolution (분리능)", "group": "basic", "def": "섞인 물질을 서로 얼마나 잘 떼어 내는지의 정도.", "src": "WK03 강의 녹음 25:20–27:48"},
    {"no": 7, "term": "Fraction (분획)", "group": "basic", "def": "컬럼에서 나오는 용액을 시간 순서대로 나눠 받은 것.", "src": "WK03 강의 녹음 07:56–08:30, 37:18–39:56"},
    {"no": 8, "term": "Capture (포획 단계)", "group": "step", "def": "배양액에서 목표 단백질을 처음 잡는 첫 정제 단계.", "src": "WK03 강의 녹음 29:54–31:11"},
    {"no": 9, "term": "Intermediate purification (중간 정제)", "group": "step", "def": "첫 단계 뒤에 남은 불순물을 더 줄이는 단계.", "src": "WK03 강의 녹음 29:54–31:11"},
    {"no": 10, "term": "Polishing (최종 정제)", "group": "step", "def": "마지막에 남은 미량 불순물을 없애는 단계.", "src": "WK03 강의 녹음 29:54–31:11"},
    {"no": 11, "term": "Affinity chromatography (친화 크로마토그래피)", "group": "type", "def": "목표 물질에만 붙는 리간드로 한 번에 크게 정제하는 방법.", "src": "WK03 강의 녹음 11:32–13:36"},
    {"no": 12, "term": "IEX (Ion Exchange, 이온교환)", "group": "type", "def": "전하 차이로 붙였다가 염 농도를 올려 떼어 내는 방법.", "src": "WK03 강의 녹음 10:07"},
    {"no": 13, "term": "HIC (Hydrophobic Interaction Chromatography)", "group": "type", "def": "소수성(물을 싫어하는 성질) 차이로 붙여 나누는 방법.", "src": "WK03 강의 녹음 11:32–13:36, 36:31"},
    {"no": 14, "term": "MMC (Multimodal Chromatography)", "group": "type", "def": "전하·소수성 등 여러 성질을 함께 써서 붙이는 레진.", "src": "WK03 강의 녹음 11:32–13:36"},
    {"no": 15, "term": "SEC (Size Exclusion, Gel filtration)", "group": "type", "def": "레진에 붙이지 않고 분자 크기로만 나누는 방법.", "src": "WK03 강의 녹음 14:25, 36:31"},
    {"no": 16, "term": "Ligand (리간드)", "group": "type", "def": "레진에 달려 목표 물질을 붙잡는 손 역할의 분자.", "src": "WK03 강의 녹음 33:05–36:20"},
    {"no": 17, "term": "Bind-elute mode (결합-용출 모드)", "group": "mode", "def": "목표 물질을 레진에 붙였다가 떼어 내 회수하는 운전 방식.", "src": "WK03 강의 녹음 33:05–36:20"},
    {"no": 18, "term": "Flow-through mode (통과 모드)", "group": "mode", "def": "불순물만 붙이고 목표 물질은 흘려보내는 운전 방식.", "src": "WK03 강의 녹음 33:05–36:20"},
    {"no": 19, "term": "Binding capacity (결합 용량)", "group": "mode", "def": "레진이 붙잡을 수 있는 단백질의 최대량 — 목표량보다 넉넉해야 한다.", "src": "WK03 강의 녹음 33:05–36:20"},
    {"no": 20, "term": "Loading (시료 주입)", "group": "mode", "def": "낮은 염 조건에서 시료를 컬럼에 흘려 붙이는 단계.", "src": "WK03 강의 녹음 10:07"},
    {"no": 21, "term": "Elution (용출)", "group": "mode", "def": "붙어 있던 물질을 염·pH 등을 바꿔 떼어 내는 것.", "src": "WK03 강의 녹음 10:07, 36:31"},
    {"no": 22, "term": "Linear gradient (직선 기울기 용출)", "group": "mode", "def": "염 농도를 일정하게 조금씩 올려 전체 패턴을 보는 용출.", "src": "WK03 강의 녹음 37:18–39:56"},
    {"no": 23, "term": "Step elution (계단식 용출)", "group": "mode", "def": "염 농도를 2~3단계로 한 번에 바꾸는 단순한 용출.", "src": "WK03 강의 녹음 37:18–39:56"},
    {"no": 24, "term": "Gradient mixer (믹서)", "group": "system", "def": "펌프 A·B의 두 버퍼를 섞어 원하는 염 농도를 만드는 장치.", "src": "WK03 강의 녹음 18:54–23:07", "drop": true},
    {"no": 25, "term": "Air trap (에어 트랩)", "group": "system", "def": "컬럼에 공기가 들어가지 않게 기포를 잡는 장치.", "src": "WK03 강의 녹음 18:54–23:07", "drop": true},
    {"no": 26, "term": "Pressure sensor (압력 센서)", "group": "system", "def": "막힘을 알려 주는 계기 — 값이 너무 높으면 바로 멈춘다.", "src": "WK03 강의 녹음 18:54–23:07", "drop": true},
    {"no": 27, "term": "UV 280 nm", "group": "system", "def": "단백질 양을 보는 자외선 흡광 파장.", "src": "WK03 강의 녹음 15:01–17:36"},
    {"no": 28, "term": "UV 260 nm", "group": "system", "def": "핵산(DNA·RNA) 양을 보는 자외선 흡광 파장.", "src": "WK03 강의 녹음 15:01–17:36"},
    {"no": 29, "term": "Conductivity (전도도)", "group": "system", "def": "용액에 녹은 염의 농도를 나타내는 값.", "src": "WK03 강의 녹음 15:01–17:36"},
    {"no": 30, "term": "Fraction collector (분획 수집기)", "group": "system", "def": "컬럼에서 나오는 용액을 튜브에 나눠 받는 장치.", "src": "WK03 강의 녹음 18:54–23:07", "drop": true},
    {"no": 31, "term": "Bradford·Lowry·BCA assay", "group": "analysis", "def": "정제한 단백질의 농도를 재는 방법들.", "src": "WK03 강의 녹음 40:25–41:40"},
    {"no": 32, "term": "SDS-PAGE", "group": "analysis", "def": "단백질을 크기별 띠(밴드)로 나눠 순도를 보는 전기영동.", "src": "WK03 강의 녹음 40:25–41:40"},
    {"no": 33, "term": "Western blot", "group": "analysis", "def": "항체로 특정 단백질이 있는지 확인하는 방법.", "src": "WK03 강의 녹음 40:25–41:40"},
    {"no": 34, "term": "ELISA", "group": "analysis", "def": "항체 반응으로 특정 단백질의 양을 재는 방법.", "src": "WK03 강의 녹음 40:25–41:40"},
    {"no": 35, "term": "Desalting (탈염)", "group": "sec", "def": "염·작은 분자를 빼고 버퍼를 바꾸는 보조 단계(다음 IEX 준비).", "src": "WK03 강의 녹음 42:18–42:56"},
    {"no": 36, "term": "Group separation (그룹 분리)", "group": "sec", "def": "큰 분자와 작은 분자를 두 무리로 거칠게 나누는 SEC.", "src": "WK03 강의 녹음 56:26–58:33"},
    {"no": 37, "term": "Sephadex G-25", "group": "sec", "def": "단백질은 배제되고 염만 구멍에 들어가는 탈염용 레진.", "src": "WK03 강의 녹음 56:26–59:53", "drop": true},
    {"no": 38, "term": "Void volume (V0)", "group": "sec", "def": "구멍에 못 들어가는 가장 큰 분자가 먼저 나오는 부피.", "src": "WK03 강의 녹음 43:25–44:31"},
    {"no": 39, "term": "Total volume (Vt)", "group": "sec", "def": "가장 작은 분자가 마지막에 나오는 부피.", "src": "WK03 강의 녹음 43:25–44:31"},
    {"no": 40, "term": "Column volume (CV)", "group": "sec", "def": "컬럼 단면적 × 높이로 구하는 원통 부피.", "src": "WK03 강의 녹음 43:25–44:31"},
    {"no": 41, "term": "Fine fractionation (정밀 분획)", "group": "sec", "def": "크기가 비슷한 분자까지 나누는 SEC — 시료는 컬럼 부피의 약 2% 이하.", "src": "WK03 강의 녹음 45:00–47:39", "drop": true},
    {"no": 42, "term": "Superdex Increase", "group": "sec", "def": "약 10 µm 작은 비드로 분리능이 높은 분석용 SEC 레진.", "src": "WK03 강의 녹음 51:08–52:03", "drop": true},
    {"no": 43, "term": "Superdex prep grade", "group": "sec", "def": "약 34 µm 비드의 생산용 SEC 레진.", "src": "WK03 강의 녹음 51:08–52:03", "drop": true},
    {"no": 44, "term": "Sephacryl S-100", "group": "sec", "def": "좁은 분자량 범위를 잘 나누는 SEC 레진.", "src": "WK03 강의 녹음 53:34–56:00", "drop": true},
    {"no": 45, "term": "Sephacryl S-400", "group": "sec", "def": "넓은 분자량 범위를 나누는 SEC 레진.", "src": "WK03 강의 녹음 53:34–56:00", "drop": true},
    {"no": 46, "term": "Swelling (팽윤)", "group": "prep", "def": "건조 레진을 물(버퍼)에 불려 부피를 키우는 것.", "src": "WK03 강의 녹음 59:53–1:00:49", "drop": true},
    {"no": 47, "term": "Packing (컬럼 충전)", "group": "prep", "def": "불린 레진을 컬럼에 고르게 채우는 작업.", "src": "WK03 강의 녹음 59:53–1:00:49", "drop": true},
    {"no": 48, "term": "Scale-up (랩 → 파일럿 → 생산)", "group": "prep", "def": "실험실 규모 조건을 수십~수백 배 큰 생산 규모로 옮기는 것.", "src": "WK03 강의 녹음 24:47", "drop": true},
    {"no": 49, "term": "Supply diversification (공급 다변화)", "group": "prep", "def": "한 회사에 의존하지 않도록 대체 공급사를 확보해 두는 것.", "src": "WK03 강의 녹음 48:02–50:33", "drop": true}
  ]
}
