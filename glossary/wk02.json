  "terms": [
    {"no": 1, "term": "PBT (Protein-Based Therapeutics)", "group": "modality", "def": "항체·ADC·재조합 단백질처럼 단백질로 된 치료제 묶음.", "src": "WK02 PDF p.5 (PBT Modalities)", "note": "2022년 시장 2,600억 달러 → 2025년 4,600억 달러.", "drop": true},
    {"no": 2, "term": "VBT (Viral-Based Therapeutics)", "group": "modality", "def": "AAV·렌티바이러스·mRNA 백신처럼 바이러스·핵산 기반 치료제 묶음.", "src": "WK02 PDF p.6 (VBT Modalities)", "drop": true},
    {"no": 3, "term": "Naked mAb", "group": "modality", "def": "아무것도 붙이지 않은 단일클론항체 그 자체로 작용하는 치료제.", "src": "WK02 PDF p.5"},
    {"no": 4, "term": "ADC (Antibody Drug Conjugate)", "group": "modality", "def": "항체에 세포독성 약물을 붙여 표적 세포로 약을 실어 나르는 치료제.", "src": "WK02 PDF p.5"},
    {"no": 5, "term": "Bi-/Multi-specific antibody", "group": "modality", "def": "두 개 이상의 서로 다른 항원에 동시에 붙도록 만든 항체.", "src": "WK02 PDF p.5"},
    {"no": 6, "term": "Plasma-derived protein (혈장 유래 단백질)", "group": "modality", "def": "사람 혈장에서 얻는 알부민·면역글로불린 같은 단백질 약.", "src": "WK02 PDF p.5 · WK06 PDF p.12"},
    {"no": 7, "term": "AAV (Adeno-Associated Virus)", "group": "vector", "def": "HEK293 세포 안에서 만들어 세포를 깨서 회수하는 유전자치료 벡터.", "src": "WK02 PDF p.6, p.12 · WK02 강의 녹음 24:07–25:49", "note": "Luxturna(2017), Zolgensma(2019)."},
    {"no": 8, "term": "Lentivirus / Retrovirus vector", "group": "vector", "def": "환자 세포에 유전자를 넣어 CAR-T 등을 만들 때 쓰는 바이러스 벡터.", "src": "WK02 PDF p.6"},
    {"no": 9, "term": "Viral vector vaccine", "group": "vector", "def": "항원 유전자를 아데노바이러스 등에 실어 만든 백신.", "src": "WK02 PDF p.6, p.10"},
    {"no": 10, "term": "Nucleic acid vaccine (mRNA/pDNA)", "group": "vector", "def": "mRNA나 plasmid DNA를 넣어 몸 안에서 항원을 만들게 하는 백신.", "src": "WK02 PDF p.6, p.10"},
    {"no": 11, "term": "CAR-T", "group": "celltx", "def": "환자 T세포에 암을 알아보는 수용체 유전자를 넣은 면역세포치료제.", "src": "WK02 PDF p.7 (Advanced Therapy Modalities)", "note": "Kymriah(Novartis)가 첫 승인 CAR-T."},
    {"no": 12, "term": "MSC (중간엽 줄기세포)", "group": "celltx", "def": "골수·제대·지방에서 얻어 세포치료제 원료로 쓰는 줄기세포.", "src": "WK02 PDF p.7"},
    {"no": 13, "term": "iPSC (유도 만능 줄기세포)", "group": "celltx", "def": "다 자란 체세포를 되돌려 여러 세포로 분화할 수 있게 만든 줄기세포.", "src": "WK02 PDF p.7"},
    {"no": 14, "term": "HSC (조혈모 줄기세포)", "group": "celltx", "def": "모든 혈액 세포를 만들어 내는 줄기세포.", "src": "WK02 PDF p.7"},
    {"no": 15, "term": "TIL / NK 세포치료제", "group": "celltx", "def": "종양에 들어간 림프구나 자연살해세포를 키워 넣는 면역세포치료제.", "src": "WK02 PDF p.7", "drop": true},
    {"no": 16, "term": "Recombinant protein platform (백신)", "group": "platform", "def": "CHO·곤충세포·대장균으로 항원 단백질을 만드는, 오래 검증된 백신 방식.", "src": "WK02 PDF p.10 (Upstream Process in Platform)", "drop": true},
    {"no": 17, "term": "mRNA platform (백신)", "group": "platform", "def": "plasmid와 효소 반응으로 항원 mRNA를 만드는, 가장 빠른 백신 방식.", "src": "WK02 PDF p.10 · WK02 강의 녹음 42:52–43:09"},
    {"no": 18, "term": "Virus platform (불활화·약독화 백신)", "group": "platform", "def": "바이러스를 키워 불활화·약독화해 만드는 전통적 백신 방식.", "src": "WK02 PDF p.10", "drop": true},
    {"no": 19, "term": "LNP (Lipid Nanoparticle)", "group": "platform", "def": "mRNA를 감싸 보호하고 세포 안으로 전달하는 지질 나노입자.", "src": "WK02 강의 녹음 42:52–43:09"},
    {"no": 20, "term": "Transfection", "group": "host", "def": "plasmid 같은 외래 DNA를 동물세포 안으로 넣는 조작.", "src": "WK02 PDF p.12–13 (AAV process optimization)"},
    {"no": 21, "term": "HEK293 (T)", "group": "host", "def": "사람 배아 신장 유래 세포주로, AAV를 만드는 숙주세포.", "src": "WK02 PDF p.12"},
    {"no": 22, "term": "CHO 세포", "group": "host", "def": "햄스터 난소 유래 세포주로, 항체를 분비하는 대표 생산 세포.", "src": "WK02 PDF p.47–49, p.55", "short": true, "answersExtra": ["CHO cell", "CHO세포"]},
    {"no": 23, "term": "Suspension cell (부유 세포)", "group": "host", "def": "표면에 붙지 않고 배지 속에 떠서 자라는 세포.", "src": "WK02 강의 녹음 45:56–48:06"},
    {"no": 24, "term": "Adherent cell (부착 세포)", "group": "host", "def": "표면에 붙어야 자라는 세포(넓은 면적 필요).", "src": "WK02 강의 녹음 45:56–48:06"},
    {"no": 25, "term": "Microcarrier (마이크로캐리어)", "group": "host", "def": "부착 세포를 붙여 배지 속에 띄워 키우는 작은 구슬.", "src": "WK02 강의 녹음 45:56–48:06"},
    {"no": 26, "term": "Cell line (세포주)", "group": "bank", "def": "목표 물질을 안정적으로 만들도록 골라낸, 한 세포에서 나온 세포 집단.", "src": "WK02 PDF p.17 (About Cell Culture Process)"},
    {"no": 27, "term": "CLD (Cell Line Development)", "group": "bank", "def": "유전자를 넣은 세포 중 생산성이 가장 높은 클론을 골라내는 단계.", "src": "WK02 강의 녹음 56:41–59:34", "short": true, "answersExtra": ["세포주 개발"]},
    {"no": 28, "term": "RCB (Research Cell Bank)", "group": "bank", "def": "세포주 개발 직후 만든 연구용 세포은행.", "src": "WK02 PDF p.16 (수업 필기: Cell Banking)", "short": true, "answersExtra": ["연구 세포은행"]},
    {"no": 29, "term": "MCB (Master Cell Bank)", "group": "bank", "def": "선별 클론을 GMP 시설에서 키워 수백 vial로 동결한 최상위(원본) 세포은행.", "src": "WK02 PDF p.16 (수업 필기: Cell Banking)", "note": "CHO 기준 vial당 약 1×10⁷ cells, 200~300 vial.", "short": true, "answersExtra": ["마스터 세포은행", "주 세포은행"]},
    {"no": 30, "term": "WCB (Working Cell Bank)", "group": "bank", "def": "원본 은행 vial을 녹여 키워 다시 동결한 작업용 세포은행 — 생산은 여기서 시작.", "src": "WK02 PDF p.16 (수업 필기: Cell Banking)", "short": true, "answersExtra": ["작업 세포은행"]},
    {"no": 31, "term": "EPC (End of Production Cells)", "group": "bank", "def": "생산이 끝난 시점의 세포 — 세포가 변하지 않았는지 확인용.", "src": "WK02 PDF p.16 (수업 필기: Cell Banking)"},
    {"no": 32, "term": "Cell banking", "group": "bank", "def": "같은 세포를 여러 vial로 동결해 매 배치를 같은 출발점에서 시작하게 하는 것.", "src": "WK02 PDF p.16"},
    {"no": 33, "term": "Seed train (종배양)", "group": "stream", "def": "녹인 세포를 flask → 작은 배양기 → 큰 배양기로 단계적으로 늘리는 과정.", "src": "WK02 PDF p.15, p.36", "short": true, "answersExtra": ["시드 트레인", "시드트레인"]},
    {"no": 34, "term": "Subculture (계대배양)", "group": "stream", "def": "자란 세포를 새 배지가 든 용기로 옮겨 다시 키우는 것.", "src": "WK02 PDF p.36 · WK02 강의 녹음"},
    {"no": 35, "term": "N-1 bioreactor", "group": "stream", "def": "생산 배양기 바로 앞의 마지막 seed 배양기.", "src": "WK02 PDF p.36, p.38"},
    {"no": 36, "term": "Production bioreactor (본배양기)", "group": "stream", "def": "목표 물질을 실제로 대량 생산하는 가장 큰 배양기.", "src": "WK02 PDF p.15, p.36"},
    {"no": 37, "term": "Harvest / Clarification", "group": "stream", "def": "배양 후 원심분리·여과로 세포를 걷어 내 맑은 상등액을 얻는 단계.", "src": "WK02 PDF p.15"},
    {"no": 38, "term": "Capture chromatography", "group": "stream", "def": "정제 첫 단계에서 목표 단백질만 붙잡아 농축하는 크로마토그래피(항체는 Protein A).", "src": "WK02 PDF p.15 · WK06 PDF p.18"},
    {"no": 39, "term": "DS (Drug Substance, 원료의약품)", "group": "stream", "def": "배양·정제로 얻은, 아직 완제가 아닌 약효 성분 벌크.", "src": "WK02 PDF p.16 (수업 필기: DS(USP)/DS(DSP)/DP)", "short": true, "answersExtra": ["원료 의약품"]},
    {"no": 40, "term": "DP (Drug Product, 완제의약품)", "group": "stream", "def": "원료의약품을 제형화·충전해 환자에게 쓰는 최종 형태로 만든 약.", "src": "WK02 PDF p.16 · GMP01 PDF p.4", "short": true, "answersExtra": ["완제 의약품"]},
    {"no": 41, "term": "Cryopreservation (동결 보존)", "group": "stream", "def": "세포 vial이나 벌크를 아주 낮은 온도로 얼려 오래 보관하는 것.", "src": "WK02 PDF p.15"},
    {"no": 42, "term": "Batch culture (회분식 배양)", "group": "mode", "def": "처음 넣은 배지만으로 끝까지 키우는 방식(단순, 생산성 낮음).", "src": "WK02 PDF p.30 (Type of Cell Culture Processing)", "short": true, "answersExtra": ["Batch", "회분식"]},
    {"no": 43, "term": "Fed-batch culture (유가식 배양)", "group": "mode", "def": "중간에 영양분(feed)을 더 넣고 끝날 때 한 번에 수확하는 방식.", "src": "WK02 PDF p.30, p.33, p.37", "note": "약 2주 운전, 정제 라인 하나에 배양기 4~6기.", "short": true},
    {"no": 44, "term": "Continuous culture (연속식 배양)", "group": "mode", "def": "배지를 계속 넣으며 세포가 든 배양액을 같은 속도로 빼내는 방식.", "src": "WK02 PDF p.30 · WK02 강의 녹음 01:01:34", "short": true, "answersExtra": ["Continuous", "연속식"]},
    {"no": 45, "term": "Perfusion culture (관류 배양)", "group": "mode", "def": "세포는 붙잡아 두고 세포 없는 상등액만 빼며 새 배지를 넣는 방식.", "src": "WK02 PDF p.33 · WK02 강의 녹음 01:01:34–01:02:26", "short": true, "answersExtra": ["Perfusion", "관류"]},
    {"no": 46, "term": "Bolus feed", "group": "mode", "def": "영양분을 정해진 때에 한 번에 몰아서 넣는 공급 방식.", "src": "WK02 PDF p.37 (Standard Fed-Batch)", "drop": true},
    {"no": 47, "term": "N-1 perfusion high inoculum fed-batch", "group": "pi", "def": "마지막 seed를 관류로 고밀도로 키워 본배양을 높은 밀도로 시작하는 전략.", "src": "WK02 PDF p.38–39", "note": "본배양 운전 방식은 그대로라 허가 측면 변경 부담이 적다."},
    {"no": 48, "term": "Concentrated fed-batch", "group": "pi", "def": "UF 모드로 제품은 남기고 배지만 교환해 끝에 한 번에 수확하는 방식.", "src": "WK02 PDF p.40 (Concentrated Continuous Fed-Batch)", "drop": true},
    {"no": 49, "term": "Dynamic perfusion", "group": "pi", "def": "MF 모드로 제품을 계속 빼내 바로 정제로 보내는 본배양 관류 방식.", "src": "WK02 PDF p.41 (Dynamic Perfusion)", "note": "배양기 1기당 정제 라인 1개.", "drop": true},
    {"no": 50, "term": "Process intensification (PI, 공정 강화)", "group": "pi", "def": "고밀도·관류 등으로 생산성을 높여 설비·면적·원가를 줄이는 전략.", "src": "WK02 PDF p.34–35 (Intensified Manufacturing)"},
    {"no": 51, "term": "CRD (Cell Retention Device)", "group": "perf", "def": "관류 배양에서 세포는 붙잡고 상등액만 내보내는 장치.", "src": "WK02 PDF p.33, p.42", "drop": true},
    {"no": 52, "term": "ATF (Alternating Tangential Flow)", "group": "perf", "def": "펌프가 빨았다 밀었다 하며 hollow fiber로 상등액만 거르는 세포 유지 장치.", "src": "WK02 PDF p.42 · WK02 강의 녹음 02:14:39–02:16:44", "short": true},
    {"no": 53, "term": "Hollow fiber membrane", "group": "perf", "def": "국수 가닥 같은 속 빈 섬유 다발 필터.", "src": "WK02 PDF p.42", "drop": true},
    {"no": 54, "term": "Cell bleed", "group": "perf", "def": "세포 밀도를 일정하게 하려고 세포가 든 배양액을 조금씩 빼는 것.", "src": "WK02 PDF p.42–43", "drop": true},
    {"no": 55, "term": "Permeate (filtrate)", "group": "perf", "def": "막을 통과해 나온 세포 없는 액체.", "src": "WK02 PDF p.40–41", "drop": true},
    {"no": 56, "term": "Direct capture", "group": "perf", "def": "배양 중 회수한 제품을 저장 없이 바로 포획 크로마토그래피로 보내는 것.", "src": "WK02 PDF p.41", "drop": true},
    {"no": 57, "term": "Lag phase (유도기)", "group": "growth", "def": "새 환경에 적응하느라 세포 수가 거의 늘지 않는 초기 시기.", "src": "WK02 PDF p.31 (General Animal Cell Growth Curve)", "short": true, "answersExtra": ["적응기", "지연기"]},
    {"no": 58, "term": "Log phase (대수기)", "group": "growth", "def": "세포 수가 빠르게(대수적으로) 늘어나는 시기.", "src": "WK02 PDF p.31", "short": true, "answersExtra": ["대수증식기", "Exponential phase", "지수기"]},
    {"no": 59, "term": "Stationary phase (정지기)", "group": "growth", "def": "증식과 사멸이 비슷해 세포 수가 일정하고 항체가 주로 만들어지는 시기.", "src": "WK02 PDF p.31 · WK02 강의 녹음 02:03:39–02:07:29", "short": true},
    {"no": 60, "term": "Death phase (사멸기)", "group": "growth", "def": "독성 물질이 쌓여 살아 있는 세포 수가 줄어드는 시기.", "src": "WK02 PDF p.31", "short": true},
    {"no": 61, "term": "VCD (Viable Cell Density)", "group": "growth", "def": "배양액 1 mL당 살아 있는 세포 수.", "src": "WK02 PDF p.58–62", "short": true, "answersExtra": ["생세포 밀도", "생세포 농도"]},
    {"no": 62, "term": "Viability (생존율)", "group": "growth", "def": "전체 세포 중 살아 있는 세포의 비율(%).", "src": "WK02 PDF p.25, p.58", "short": true},
    {"no": 63, "term": "Peak VCD", "group": "growth", "def": "배양 중 도달한 가장 높은 생세포 밀도.", "src": "WK02 PDF p.61–62 · WK02 강의 녹음 02:03:39", "drop": true},
    {"no": 64, "term": "Temperature shift (온도 전환)", "group": "growth", "def": "목표 밀도까지 37 ℃로 키운 뒤 32 ℃ 정도로 낮춰 생산을 유도하는 전략.", "src": "WK02 PDF p.16 (필기), p.22 · WK02 강의 녹음 01:16:27–01:19:46", "short": true, "answersExtra": ["온도 변환", "temperature shift"]},
    {"no": 65, "term": "Inoculation density (접종 밀도)", "group": "growth", "def": "배양을 시작할 때 넣는 세포 농도.", "src": "WK02 PDF p.56–58, p.62", "drop": true},
    {"no": 66, "term": "Basal medium (기본 배지)", "group": "media", "def": "당·아미노산·비타민·염 등 세포 성장의 기본 성분으로 된 배지.", "src": "WK02 PDF p.46 (Energy Source for Cell Growth)"},
    {"no": 67, "term": "Media supplement (배지 첨가물)", "group": "media", "def": "성장인자·가수분해물처럼 기본 배지에 더 넣어 성장을 돕는 성분.", "src": "WK02 PDF p.46"},
    {"no": 68, "term": "Spent media analysis (사용 배지 분석)", "group": "media", "def": "배양 중 배지 성분이 얼마나 줄고 쌓였는지 분석하는 것.", "src": "WK02 PDF p.49, p.74", "drop": true},
    {"no": 69, "term": "Glucose (포도당)", "group": "metab", "def": "세포의 주 에너지원인 당.", "src": "WK02 PDF p.46"},
    {"no": 70, "term": "Lactate (젖산)", "group": "metab", "def": "포도당 대사로 쌓여 pH를 낮추는 대사산물.", "src": "WK02 PDF p.47 · WK02 강의 녹음 01:16:27", "short": true},
    {"no": 71, "term": "Glutamine (글루타민)", "group": "metab", "def": "질소·탄소 공급원 아미노산으로, 분해되면 암모늄이 생긴다.", "src": "WK02 PDF p.47"},
