    {"no": 2, "term": "Product-related impurity (제품 유래 불순물)", "group": "dsp", "def": "Aggregate·산화·잘못 접힌 단백질처럼 제품 자체가 변한 불순물(품질↓).", "src": "WK04 PDF p.9 (Impurities)", "short": true},
    {"no": 3, "term": "Precipitation (침전)", "group": "dsp", "def": "알코올·PEG 등을 넣어 목표 물질을 가라앉혀 나누는 1차 정제 방법.", "src": "WK04 PDF p.11 (Precipitation)", "short": true},
    {"no": 4, "term": "Centrifugation (원심분리)", "group": "dsp", "def": "빠르게 돌려 무거운 세포·찌꺼기를 가라앉혀 나누는 방법.", "src": "WK04 PDF p.10, p.12 (Centrifuge)", "short": true},
    {"no": 5, "term": "Continuous centrifuge (연속 원심분리기)", "group": "dsp", "def": "load·wash·discharge를 되풀이하며 쉬지 않고 돌리는 원심분리 장비(kSep).", "src": "WK04 PDF p.12 (Centrifuge)"},
    {"no": 6, "term": "Inclusion body (봉입체)", "group": "dsp", "def": "세균 안에서 잘못 접혀 뭉친 단백질 덩어리.", "src": "WK04 PDF p.14 (Case Study – r-Insulin)", "short": true},
    {"no": 7, "term": "Refolding (재접힘)", "group": "dsp", "def": "녹여 낸 단백질을 다시 올바른 구조로 접는 단계.", "src": "WK04 PDF p.14 (Case Study – r-Insulin)"},
    {"no": 8, "term": "Cell lysis (세포 파쇄)", "group": "dsp", "def": "세포 안에 만들어진 산물을 꺼내려고 세포를 깨는 것.", "src": "WK04 PDF p.13 (IB Process)"},
    {"no": 9, "term": "Fill & Finish (F&F)", "group": "dsp", "def": "제형화·최종 무균 여과·충전·캡핑으로 완제품을 만드는 마지막 공정.", "src": "WK04 PDF p.17 (F&F)"},
    {"no": 10, "term": "BFS (Blow Fill Seal)", "group": "dsp", "def": "용기를 성형하자마자 충전·밀봉까지 한 번에 하는 방식.", "src": "WK04 PDF p.17 (F&F)", "drop": true},
    {"no": 11, "term": "Media mitigation (배지 오염 저감)", "group": "dsp", "def": "감마선·HTST·UV-C·멸균·여과로 배지의 오염 위험을 줄이는 것.", "src": "WK04 PDF p.16 (항체 정제 공정)", "drop": true},
    {"no": 12, "term": "Filtration (여과)", "group": "basic", "def": "상(相)·크기가 다른 물질을 물리적·기계적으로 나누는 것.", "src": "WK04 PDF p.22 (여과는 어떻게 이루어지는가?)"},
    {"no": 13, "term": "Driving pressure difference (P1 − P2)", "group": "basic", "def": "필터 앞뒤 압력 차 — 이 차이가 유체를 움직인다.", "src": "WK04 PDF p.22 (구동 원리)", "drop": true},
    {"no": 14, "term": "Clarification", "group": "basic", "def": "배양액 속 세포·세포 찌꺼기(수 µm 입자)를 필터로 걸러 내는 공정.", "src": "WK04 PDF p.23 (Filtration: Unit Operation)", "short": true, "answersExtra": ["청징", "정화"]},
    {"no": 15, "term": "Pre-filter (사전 여과)", "group": "basic", "def": "최종 필터 앞에서 큰 입자를 먼저 걸러 막힘을 줄이는 필터.", "src": "WK04 PDF p.23, p.39"},
    {"no": 16, "term": "Sterilizing-grade filter (제균 필터)", "group": "basic", "def": "세균 도전 시험에서 여과액이 무균으로 나온 0.2 µm 급 필터.", "src": "WK04 PDF p.24 (제균 Filter의 정의)", "short": true, "answersExtra": ["제균 여과 필터", "멸균 필터", "0.2 µm 필터"]},
    {"no": 17, "term": "BCT (Bacteria Challenge Test)", "group": "basic", "def": "막 cm²당 10⁷개의 작은 세균을 걸러 여과액이 무균인지 보는 시험.", "src": "WK04 PDF p.24, p.121", "short": true, "answersExtra": ["세균 도전 시험", "세균 챌린지 시험"]},
    {"no": 18, "term": "Brevundimonas diminuta", "group": "basic", "def": "제균 필터 시험에 쓰는 아주 작은 세균(worst case).", "src": "WK04 PDF p.24 (Bacteria Challenge Test)", "short": true, "answers": ["Brevundimonas diminuta", "B. diminuta", "B.diminuta", "브레분디모나스 디미누타"]},
    {"no": 19, "term": "Filtrate (여과액)", "group": "basic", "def": "필터를 통과해 뒤로 나온 액체.", "src": "WK04 PDF p.43 (Membrane + Depth)"},
    {"no": 20, "term": "DEF (Dead-End Filtration)", "group": "mech", "def": "액체를 막에 수직으로 밀어 넣어 모두 통과시키는 여과.", "src": "WK04 PDF p.26 (Mechanism)", "short": true, "answersExtra": ["Dead-end filtration", "막다른 여과", "데드엔드 여과"]},
    {"no": 21, "term": "CFF / TFF (Crossflow Filtration · Tangential Flow Filtration)", "group": "mech", "def": "액체가 막 표면을 따라 흐르며 일부만 막을 지나가는 여과.", "src": "WK04 PDF p.26, p.85", "short": true, "answersExtra": ["접선 흐름 여과", "십자류 여과", "크로스플로우 여과", "Crossflow·Tangential Flow Filtration", "Crossflow filtration", "Tangential flow filtration"]},
    {"no": 22, "term": "Microfiltration (MF, 정밀여과)", "group": "mech", "def": "0.1~100 µm 구멍으로 세포·입자를 거르는 여과.", "src": "WK04 PDF p.32 (Size에 따른 분리)", "short": true},
    {"no": 23, "term": "Ultrafiltration (UF, 한외여과)", "group": "mech", "def": "nm 수준 구멍으로 단백질은 남기고 물·염은 빼는 여과.", "src": "WK04 PDF p.32 (Size에 따른 분리)", "short": true},
    {"no": 24, "term": "Nanofiltration (NF, 나노여과)", "group": "mech", "def": "2~5 nm 구멍의 여과 — 바이러스 여과도 여기에 속한다.", "src": "WK04 PDF p.32, p.40", "short": true},
    {"no": 25, "term": "Reverse osmosis (RO, 역삼투)", "group": "mech", "def": "가장 작은 막에 아주 높은 압력을 걸어 이온까지 거르는 여과.", "src": "WK04 PDF p.32 (Size에 따른 분리)", "short": true},
    {"no": 26, "term": "MWCO (Molecular Weight Cut-Off)", "group": "mech", "def": "막이 걸러 내는 분자 크기를 분자량(kDa)으로 나타낸 값.", "src": "WK04 PDF p.46 (Pore Size / MWCO)", "short": true, "answersExtra": ["분자량 컷오프", "분자량 차단"]},
    {"no": 27, "term": "Size exclusion (크기 배제)", "group": "mech", "def": "구멍보다 큰 것은 남기고 작은 것은 통과시키는 분리 원리.", "src": "WK04 PDF p.27, p.29"},
    {"no": 28, "term": "Membrane filter", "group": "material", "def": "얇은 막 표면에서 걸러, 압력이 높아도 입자가 뒤로 넘어가지 않는 필터.", "src": "WK04 PDF p.40 (Membrane Filter)", "short": true, "answersExtra": ["멤브레인 필터"]},
    {"no": 29, "term": "Depth filter (깊이 필터)", "group": "material", "def": "두꺼운 섬유층 안에 입자를 많이 붙잡지만 압력이 높으면 샐 수 있는 필터.", "src": "WK04 PDF p.41 (Depth filter)", "short": true, "answersExtra": ["뎁스 필터", "심층 필터"]},
    {"no": 30, "term": "Combination filter (Depth + Membrane)", "group": "material", "def": "Depth filter층과 막을 합쳐 많이 잡으면서 확실히 거르는 필터.", "src": "WK04 PDF p.43", "drop": true},
    {"no": 31, "term": "PES (Polyethersulfone)", "group": "material", "def": "제균 필터(Sartopore)에 많이 쓰는 합성 고분자 막 재질.", "src": "WK04 PDF p.34–35", "drop": true},
    {"no": 32, "term": "PTFE (Polytetrafluoroethylene)", "group": "material", "def": "물을 밀어내는(소수성) 막 재질 — 기체·vent 필터에 쓴다.", "src": "WK04 PDF p.34, p.51"},
    {"no": 33, "term": "Cellulose acetate (CA)", "group": "material", "def": "셀룰로스 유도체로 만든 막 재질(Sartobran P).", "src": "WK04 PDF p.34–35", "drop": true},
    {"no": 34, "term": "PP (Polypropylene)", "group": "material", "def": "Depth filter에 쓰는 플라스틱 섬유 재질.", "src": "WK04 PDF p.34, p.42", "drop": true},
    {"no": 35, "term": "Glass fiber (유리섬유)", "group": "material", "def": "Depth filter에 쓰는 가는 유리 실 재질.", "src": "WK04 PDF p.34, p.42", "drop": true},
    {"no": 36, "term": "Diatomaceous earth (규조토)", "group": "material", "def": "Depth filter에 보조재로 넣어 미세 입자를 잘 붙잡게 하는 광물 가루.", "src": "WK04 PDF p.42 (Depth filter)", "drop": true},
    {"no": 37, "term": "Asymmetric membrane (비대칭 막)", "group": "material", "def": "흐르는 방향으로 갈수록 구멍이 작아지는 막 구조.", "src": "WK04 PDF p.39 (Asymmetric PES Membranes)", "drop": true},
    {"no": 38, "term": "Hydrophilic membrane (친수성 막)", "group": "material", "def": "물에 잘 젖는 막 — 액체 여과에 쓴다.", "src": "WK04 PDF p.40, p.124"},
    {"no": 39, "term": "Hydrophobic membrane (소수성 막)", "group": "material", "def": "물을 밀어내는 막 — 기체·vent 여과에 쓴다.", "src": "WK04 PDF p.40, p.51, p.124", "short": true, "answersExtra": ["소수성막", "Hydrophobic filter", "소수성 필터"]},
    {"no": 40, "term": "Membrane casting (막 캐스팅)", "group": "material", "def": "고분자 용액을 얇게 펴 구멍 구조를 만들고 말려 막을 만드는 공정.", "src": "WK04 PDF p.36–38", "drop": true},
    {"no": 41, "term": "Pore size (기공 크기)", "group": "pore", "def": "막 구멍의 크기(예: 0.2 µm) — Membrane filter의 표기 방식.", "src": "WK04 PDF p.44 (Pore Size / Retention Rate)"},
    {"no": 42, "term": "Retention rate (보유율)", "group": "pore", "def": "정해진 크기의 입자를 걸러 내는 비율(%) — Depth filter의 표기 방식.", "src": "WK04 PDF p.44–45", "drop": true},
    {"no": 43, "term": "Absolute rating (절대 등급)", "group": "pore", "def": "표시한 크기의 입자를 거의 모두(예: 99.98 % 이상) 걸러 내는 등급.", "src": "WK04 PDF p.44"},
    {"no": 44, "term": "Nominal rating (공칭 등급)", "group": "pore", "def": "표시한 크기의 입자를 일정 비율만 걸러 내는 등급.", "src": "WK04 PDF p.44"},
    {"no": 45, "term": "Beta ratio (β, 여과비)", "group": "pore", "def": "필터 앞 입자 수 ÷ 뒤 입자 수 — 클수록 잘 거른다.", "src": "WK04 PDF p.44", "drop": true},
    {"no": 46, "term": "Vent filter", "group": "gas", "def": "탱크에 공기가 드나들게 하면서 오염은 막는 기체 필터.", "src": "WK04 PDF p.48–50"},
    {"no": 47, "term": "Tank collapse (탱크 찌그러짐)", "group": "gas", "def": "vent가 막혀 탱크 안이 진공이 되어 찌그러지는 사고.", "src": "WK04 PDF p.48–49", "drop": true},
    {"no": 48, "term": "Double vent system (이중 vent)", "group": "gas", "def": "WFI 탱크에 vent 필터를 2개 달아 하나가 문제여도 대비하는 구성.", "src": "WK04 PDF p.58 (Double Vent System)", "drop": true},
    {"no": 49, "term": "Heated vent housing (가열 vent 하우징)", "group": "gas", "def": "물기가 맺혀 vent 필터가 젖지 않도록 데우는 하우징.", "src": "WK04 PDF p.59, p.61", "drop": true},
    {"no": 50, "term": "Sieve effect (체 효과)", "group": "gas", "def": "입자가 구멍보다 커서 필터 표면에 걸리는 기전.", "src": "WK04 PDF p.52 (Gas Filter Mechanism)", "drop": true},
    {"no": 51, "term": "Impaction (관성 충돌)", "group": "gas", "def": "무거운 입자가 공기 흐름을 못 따라가 섬유에 부딪혀 잡히는 기전.", "src": "WK04 PDF p.53", "drop": true},
    {"no": 52, "term": "Interception (차단)", "group": "gas", "def": "흐름을 따라가던 입자가 섬유 바로 옆을 지나다 닿아 잡히는 기전.", "src": "WK04 PDF p.53", "drop": true},
    {"no": 53, "term": "Diffusion (Brownian motion, 확산)", "group": "gas", "def": "아주 작은 입자가 불규칙하게 움직이다 섬유에 닿아 잡히는 기전.", "src": "WK04 PDF p.54", "drop": true},
    {"no": 54, "term": "Electrostatic interaction (정전기 인력)", "group": "gas", "def": "입자와 막의 서로 다른 전하가 끌어당겨 잡히는 기전.", "src": "WK04 PDF p.54", "drop": true},
    {"no": 55, "term": "MPPS (Most Penetrating Particle Size)", "group": "gas", "def": "여러 포집 기전이 모두 약해 가장 잘 빠져나가는 입자 크기(약 0.2 µm).", "src": "WK04 PDF p.55", "drop": true},
    {"no": 56, "term": "HEPA filter grade", "group": "gas", "def": "0.3 µm 입자를 99.95 % 이상 거르는 고성능 공기 필터 등급(H13·H14).", "src": "WK04 PDF p.57", "drop": true},
    {"no": 57, "term": "Aerosol challenge test", "group": "gas", "def": "박테리오파지 같은 미세 입자를 공기에 실어 기체 필터 성능을 보는 시험.", "src": "WK04 PDF p.56", "drop": true},
    {"no": 58, "term": "Filter sizing test", "group": "size", "def": "공정에 쓸 필터 면적을 정하려고 작은 필터로 미리 해 보는 시험.", "src": "WK04 PDF p.65 (What is Filter Sizing Test?)"},
    {"no": 59, "term": "Vmax (Constant pressure method)", "group": "size", "def": "일정 압력에서 유량이 끝점까지 줄 때까지의 최대 여과량(주로 membrane).", "src": "WK04 PDF p.66", "drop": true},
    {"no": 60, "term": "Pmax (Constant flow method)", "group": "size", "def": "일정 유속에서 압력이 끝점에 이를 때까지의 최대 여과량(주로 depth filter).", "src": "WK04 PDF p.66", "drop": true},
    {"no": 61, "term": "Tmax (Constant flow method)", "group": "size", "def": "일정 유속에서 탁도가 끝점에 이를 때까지의 최대 여과량.", "src": "WK04 PDF p.66", "drop": true},
    {"no": 62, "term": "Flux (LMH)", "group": "size", "def": "막 1 m²를 1시간에 통과하는 양(L/m²/h).", "src": "WK04 PDF p.68, p.70"},
    {"no": 63, "term": "Filter capacity (L/m²)", "group": "size", "def": "막 1 m²가 처리할 수 있는 시료 양.", "src": "WK04 PDF p.68"},
    {"no": 64, "term": "Plugging (막힘)", "group": "size", "def": "입자가 쌓여 압력은 오르고 유량은 줄어드는 현상.", "src": "WK04 PDF p.64 (Filter가 막히면…)"},
    {"no": 65, "term": "Cartridge filter", "group": "system", "def": "스테인리스 하우징에 끼워 쓰고 필터만 바꾸는 형태.", "src": "WK04 PDF p.72 (Cartridge and Capsule)"},
    {"no": 66, "term": "Capsule filter", "group": "system", "def": "하우징과 필터가 한 몸인 일회용 형태.", "src": "WK04 PDF p.72 (Cartridge and Capsule)"},
    {"no": 67, "term": "Filter housing", "group": "system", "def": "필터를 담아 압력을 견디는 용기(주로 SS 316L).", "src": "WK04 PDF p.72, p.74–76"},
    {"no": 68, "term": "Pleated membrane (주름 막)", "group": "system", "def": "좁은 공간에 넓은 막 면적을 넣으려고 주름지게 접은 구조.", "src": "WK04 PDF p.73 (Filter의 구조)", "drop": true},
    {"no": 69, "term": "Sanitary clamp / Ferrule", "group": "system", "def": "배관을 위생적으로 잇는 연결부 — 규격(DIN·ASME 등)마다 크기가 다르다.", "src": "WK04 PDF p.75", "drop": true},
    {"no": 70, "term": "SS 316L (Stainless steel)", "group": "system", "def": "철에 크롬·니켈·몰리브덴을 더해 잘 녹슬지 않는 강철.", "src": "WK04 PDF p.76 (Filter Housing)", "drop": true},
    {"no": 71, "term": "Peristaltic pump (연동 펌프)", "group": "system", "def": "튜브를 눌러 밀어 보내 시료와 닿지 않는 펌프(튜브 교체 필요).", "src": "WK04 PDF p.81 (Pump)", "drop": true},
    {"no": 72, "term": "Diaphragm pump (다이어프램 펌프)", "group": "system", "def": "막을 움직여 보내는 펌프 — shear가 적지만 유량이 낮다.", "src": "WK04 PDF p.81 (Pump)", "drop": true},
    {"no": 73, "term": "Rotary lobe pump (로터리 로브 펌프)", "group": "system", "def": "날개(로브) 두 개가 돌며 보내는 펌프 — CIP·SIP와 대규모에 맞다.", "src": "WK04 PDF p.81 (Pump)", "drop": true},
    {"no": 74, "term": "Self-priming (자흡)", "group": "system", "def": "펌프가 스스로 액체를 빨아올릴 수 있는 성질.", "src": "WK04 PDF p.81 (Pump)", "drop": true},
    {"no": 75, "term": "Pressurized transfer (가압 이송)", "group": "system", "def": "압축 기체로 탱크를 눌러 액체를 보내는 방식(대규모에 흔함).", "src": "WK04 PDF p.80 (Fluid Transfer)", "drop": true},
    {"no": 76, "term": "Gravity transfer (중력 이송)", "group": "system", "def": "높이 차이만으로 액체를 보내는 방식(에너지는 안 들지만 느림).", "src": "WK04 PDF p.80 (Fluid Transfer)", "drop": true},
    {"no": 77, "term": "Feed (TFF)", "group": "tff", "def": "TFF 막으로 들어가는 액체 흐름.", "src": "WK04 PDF p.86 (CFF System의 구성)"},
    {"no": 78, "term": "Retentate (TFF)", "group": "tff", "def": "막을 지나지 못하고 탱크로 돌아가는 쪽 — 목표 물질이 남는다.", "src": "WK04 PDF p.86 (CFF System의 구성)", "short": true, "answers": ["Retentate", "리텐테이트", "잔류액", "농축액"]},
    {"no": 79, "term": "Permeate (TFF)", "group": "tff", "def": "막을 지나 빠져나간 쪽 액체.", "src": "WK04 PDF p.86 (CFF System의 구성)", "short": true, "answers": ["Permeate", "퍼미에이트", "투과액", "Filtrate", "여과액"]},
    {"no": 80, "term": "TMP (Transmembrane Pressure)", "group": "tff", "def": "막을 가로질러 걸리는 평균 압력 — 높이면 투과가 늘다 한계에 이른다.", "src": "WK04 PDF p.88, p.90", "short": true, "answersExtra": ["막간 압력", "막 횡단 압력"]},
    {"no": 81, "term": "ΔP (Pfeed − Pretentate)", "group": "tff", "def": "TFF 막 입구와 출구의 압력 차 — 높이면 표면을 씻는 흐름이 는다.", "src": "WK04 PDF p.88, p.92"},
    {"no": 82, "term": "Crossflow rate (Recirculation rate)", "group": "tff", "def": "막 표면을 따라 retentate 쪽으로 흐르는 액체의 양.", "src": "WK04 PDF p.88", "drop": true},
    {"no": 83, "term": "Gel layer (겔층)", "group": "tff", "def": "막 표면에 단백질이 몰려 생긴 층 — 투과를 막는다.", "src": "WK04 PDF p.91, p.108"},
    {"no": 84, "term": "Optimum TMP", "group": "tff", "def": "압력을 더 올려도 flux가 크게 늘지 않기 시작하는 지점.", "src": "WK04 PDF p.91, p.93", "drop": true},
    {"no": 85, "term": "Concentration (농축)", "group": "tff", "def": "용매를 빼서 목표 물질의 농도를 높이는 것.", "src": "WK04 PDF p.100, p.103"},
    {"no": 86, "term": "Diafiltration", "group": "tff", "def": "새 버퍼를 넣고 빼기를 되풀이해 기존 버퍼를 바꾸는 것.", "src": "WK04 PDF p.100, p.103", "short": true, "answersExtra": ["DF", "정용여과", "다이아 필트레이션", "다이아필트레이션"]},
    {"no": 87, "term": "Continuous diafiltration (연속 DF)", "group": "tff", "def": "빠지는 만큼 새 버퍼를 계속 넣어 부피를 일정하게 두는 방식.", "src": "WK04 PDF p.104", "drop": true},
    {"no": 88, "term": "Batch diafiltration (회분 DF)", "group": "tff", "def": "버퍼를 한 번에 넣고 다시 농축하기를 되풀이하는 방식.", "src": "WK04 PDF p.104", "drop": true},
    {"no": 89, "term": "Cassette (flat sheet module)", "group": "tff", "def": "막 sheet를 겹겹이 쌓은 TFF 모듈 — holder가 필요하다.", "src": "WK04 PDF p.95–96", "drop": true},
    {"no": 90, "term": "Hollow fiber module", "group": "tff", "def": "속 빈 섬유 다발로 된 TFF 모듈 — holder 없이 쓴다.", "src": "WK04 PDF p.95–96", "drop": true},
    {"no": 91, "term": "Spiral-wound module", "group": "tff", "def": "막을 김밥처럼 말아 감은 TFF 모듈.", "src": "WK04 PDF p.95", "drop": true},
    {"no": 92, "term": "Fouling", "group": "tff", "def": "단백질·지방 등이 막에 달라붙어 성능이 떨어지는 현상.", "src": "WK04 PDF p.108–109"},
    {"no": 93, "term": "CWF (Clean Water Flux)", "group": "tff", "def": "깨끗한 물이 막을 통과하는 flux — 카세트 상태·세척 결과 확인용.", "src": "WK04 PDF p.111", "drop": true},
    {"no": 94, "term": "NWP (Normalized Water Permeability)", "group": "tff", "def": "물 투과값을 TMP·막 면적·온도로 보정한 값.", "src": "WK04 PDF p.112", "drop": true},
    {"no": 95, "term": "Membrane life cycle (막 수명)", "group": "tff", "def": "물 투과도·무결성·품질·용출물을 보고 막을 몇 번 다시 쓸지 정한 것.", "src": "WK04 PDF p.110", "drop": true},
    {"no": 96, "term": "System hold-up volume", "group": "tff", "def": "장비 배관 안에 남는 액체 부피 — TFF 운전 전에 먼저 정한다.", "src": "WK04 PDF p.106 (Process Flow)", "drop": true},
    {"no": 97, "term": "Filter integrity test (필터 무결성 시험)", "group": "it", "def": "필터가 손상 없이 제 성능을 내는지 확인하는 시험.", "src": "WK04 PDF p.116–117"},
    {"no": 98, "term": "Destructive test (파괴검사)", "group": "it", "def": "제조사가 하는 시험으로, 끝나면 필터를 다시 쓸 수 없다(BCT 등).", "src": "WK04 PDF p.118"},
    {"no": 99, "term": "Non-destructive test (비파괴검사)", "group": "it", "def": "사용자가 하는 간접 시험으로, 필터를 다시 쓸 수 있다.", "src": "WK04 PDF p.118"},
    {"no": 100, "term": "Bubble point test (기포점 시험)", "group": "it", "def": "젖은 막에 압력을 올려 기포가 줄지어 나오는 압력을 재는 시험.", "src": "WK04 PDF p.125–126", "short": true},
    {"no": 101, "term": "Diffusion test (확산 시험)", "group": "it", "def": "Bubble point보다 낮은 압력(약 80 %)에서 막을 통해 퍼져 나오는 기체량을 재는 시험.", "src": "WK04 PDF p.127, p.131", "short": true},
    {"no": 102, "term": "Pressure drop test (압력 강하 시험)", "group": "it", "def": "확산 원리로, 필터 위쪽(상류) 압력이 떨어지는 정도를 재는 시험.", "src": "WK04 PDF p.135–136", "drop": true},
    {"no": 103, "term": "Water intrusion test (WIT)", "group": "it", "def": "소수성 필터에 물을 밀어 넣어 구멍으로 스며드는 물의 양을 재는 시험.", "src": "WK04 PDF p.137–139", "short": true, "answersExtra": ["물 침투 시험", "Water intrusion"]},
    {"no": 104, "term": "Wetting agent", "group": "it", "def": "Integrity test 전에 막 구멍을 채우는 액체(친수성은 물, 소수성은 IPA/물).", "src": "WK04 PDF p.134"},
    {"no": 105, "term": "Wetting angle (접촉각)", "group": "it", "def": "액체가 표면에 닿는 각도 — 90° 미만이면 잘 젖는다.", "src": "WK04 PDF p.125, p.128", "drop": true},
    {"no": 106, "term": "Surface tension (표면장력)", "group": "it", "def": "액체 표면이 줄어들려는 힘 — 클수록 bubble point 압력이 높다.", "src": "WK04 PDF p.125, p.134", "drop": true},
    {"no": 107, "term": "Min. Bubble point", "group": "it", "def": "필터가 무결하다고 보는 최소 bubble point 압력(합격 기준).", "src": "WK04 PDF p.151", "drop": true},
    {"no": 108, "term": "Max. Bubble point", "group": "it", "def": "합격한 필터가 손상되지 않게 시험을 멈추는 압력(무결성과 직접 관계없음).", "src": "WK04 PDF p.151", "drop": true},
    {"no": 109, "term": "IT test limit (무결성 합격 기준)", "group": "it", "def": "제조사가 BCT와 bubble point·diffusion 결과를 묶어 정해 주는 합격 기준.", "src": "WK04 PDF p.119–120", "drop": true},
    {"no": 110, "term": "Reference wetting fluid", "group": "it", "def": "물로 잘 안 젖을 때 쓰는 낮은 표면장력 액체(IPA/물)로 하는 재시험용 액.", "src": "WK04 PDF p.152, p.156", "drop": true},
    {"no": 111, "term": "PDA TR 26", "group": "it", "def": "제균 필터 integrity test와 실패 시 조치 절차를 정리한 기술 보고서.", "src": "WK04 PDF p.122, p.152–153", "drop": true},
    {"no": 112, "term": "Redundant filtration (이중 제균 여과)", "group": "it", "def": "첫 제균 필터가 실패할 때를 대비해 두 번째 제균 필터를 연달아 두는 것.", "src": "WK04 PDF p.157", "short": true, "answersExtra": ["이중 여과", "중복 여과"]},
    {"no": 113, "term": "PUPSIT (Pre-Use Post-Sterilization Integrity Test)", "group": "it", "def": "멸균한 뒤, 쓰기 직전에 하는 제균 필터 integrity test.", "src": "WK04 PDF p.17, p.158", "short": true},
    {"no": 114, "term": "Modality", "group": "rec-flow", "def": "만드는 방법(생산 공정)이 비슷한 의약품의 묶음.", "src": "WK04 강의 녹음② 00:24–02:49"},
    {"no": 115, "term": "Soluble–soluble mixture", "group": "rec-flow", "def": "녹은 물질끼리 섞인 것 — 크로마토그래피·침전으로 나눈다.", "src": "WK04 강의 녹음① 18:07–24:25"},
    {"no": 116, "term": "Soluble–insoluble mixture", "group": "rec-flow", "def": "녹은 물질과 세포처럼 안 녹는 물질이 섞인 것 — 원심분리·여과로 나눈다.", "src": "WK04 강의 녹음① 18:07–24:25"},
    {"no": 117, "term": "Plasma-derived product (혈장분획제제)", "group": "rec-flow", "def": "헌혈 혈장에서 부족한 성분을 분리해 만든 의약품.", "src": "WK04 강의 녹음② 06:42–09:42", "drop": true},
    {"no": 118, "term": "Upstream process (배양 공정)", "group": "rec-flow", "def": "부피가 커지는 방향으로 세포를 키우는 공정.", "src": "WK04 강의 녹음② 1:01:54", "drop": true},
    {"no": 119, "term": "Downstream process (정제 공정)", "group": "rec-flow", "def": "필요한 것만 남기며 부피가 줄어드는 방향으로 가는 공정.", "src": "WK04 강의 녹음② 2:12:41–2:13:56", "drop": true},
    {"no": 120, "term": "Yield (수율)", "group": "rec-flow", "def": "배양에서 만든 양을 정제 끝까지 얼마나 지켰는지의 비율.", "src": "WK04 강의 녹음② 2:13:07–2:13:43", "short": true},
    {"no": 121, "term": "Purity (순도)", "group": "rec-flow", "def": "목표 물질이 불순물 없이 깨끗한 정도.", "src": "WK04 강의 녹음② 2:13:07–2:13:43", "short": true},
    {"no": 122, "term": "Biosimilar (바이오시밀러)", "group": "rec-flow", "def": "특허가 끝난 바이오의약품과 같은 효과로 만든 복제약 — 1등이 시장을 크게 가져간다.", "src": "WK04 강의 녹음② 45:41–46:15, 2:31:03", "drop": true},
    {"no": 123, "term": "Host cell (숙주세포)", "group": "rec-cell", "def": "유전 정보를 넣어 목표 단백질을 대신 만들게 하는 세포.", "src": "WK04 강의 녹음② 12:33–14:46"},
    {"no": 124, "term": "E. coli (대장균)", "group": "rec-cell", "def": "가장 널리 쓰는 미생물 숙주 — 세포벽이 있다.", "src": "WK04 강의 녹음② 14:46–15:27"},
    {"no": 125, "term": "Cell wall (세포벽)", "group": "rec-cell", "def": "미생물에는 있고 동물세포에는 없는 바깥 껍질 — 산물이 세포 안에 쌓이는 이유.", "src": "WK04 강의 녹음② 15:12, 1:11:11–1:11:54"},
    {"no": 126, "term": "Intracellular product (세포 내 산물)", "group": "rec-cell", "def": "세포 안에 쌓이는 산물 — 미생물에서 흔하다.", "src": "WK04 강의 녹음② 1:11:27–1:11:54"},
    {"no": 127, "term": "Secretion (분비)", "group": "rec-cell", "def": "세포가 만든 산물을 밖으로 내보내는 것 — 동물세포의 방식.", "src": "WK04 강의 녹음② 1:11:27–1:11:54"},
    {"no": 128, "term": "Cell harvest", "group": "rec-cell", "def": "세포 안 산물을 얻으려고 배양 후 세포를 모으는 단계.", "src": "WK04 강의 녹음② 1:12:25–1:13:16"},
    {"no": 129, "term": "Single cell cloning", "group": "rec-cell", "def": "세포를 하나씩 따로 떼어 키우며 비교해 좋은 세포를 고르는 것.", "src": "WK04 강의 녹음② 40:41–42:32"},
    {"no": 130, "term": "Beacon", "group": "rec-cell", "def": "세포를 하나씩 분리해 비교하는 세포주 개발 장비(한 대 약 50억 원).", "src": "WK04 강의 녹음② 40:41–41:55", "drop": true},
    {"no": 131, "term": "Cell line characterization (세포주 특성 분석)", "group": "rec-cell", "def": "고른 세포가 정말 좋은지 특성을 정의·확인해 증명하는 단계.", "src": "WK04 강의 녹음② 43:38–44:19"},
    {"no": 132, "term": "EOPCB (End of Production Cell Bank)", "group": "rec-cell", "def": "생산이 끝난 세포를 처음과 비교·보관해 변하지 않았음을 확인하는 은행.", "src": "WK04 강의 녹음② 48:21–49:29"},
    {"no": 133, "term": "Doubling time (배가 시간)", "group": "rec-cell", "def": "세포 수가 두 배가 되는 데 걸리는 시간 — CHO는 약 하루.", "src": "WK04 강의 녹음② 59:28–1:00:35", "drop": true},
    {"no": 134, "term": "Titer", "group": "rec-cell", "def": "배양액 1 L에 녹아 있는 목표 단백질의 양(항체 약 2~3 g/L).", "src": "WK04 강의 녹음② 56:12–56:52"},
    {"no": 135, "term": "Feeding strategy (피딩 전략)", "group": "rec-cell", "def": "증식 단계와 생산 단계에 맞춰 먹이 성분을 다르게 주는 전략.", "src": "WK04 강의 녹음② 1:08:43–1:09:47", "drop": true},
    {"no": 136, "term": "Process development (PD, 공정 개발)", "group": "rec-cell", "def": "세포를 잘 늘리고 산물을 잘 만드는 배양·정제 조건을 찾는 일.", "src": "WK04 강의 녹음② 1:09:47", "drop": true},
    {"no": 137, "term": "VCS (Viral Clearance Study)", "group": "rec-dsp", "def": "공정 단계들이 바이러스를 없애는 효과를 증명하는 시험 — 동물 유래 의약품 필수.", "src": "WK04 강의 녹음② 1:47:26–1:48:13", "short": true, "answersExtra": ["바이러스 제거 검증", "바이러스 클리어런스 스터디"]},
    {"no": 138, "term": "Zoonosis (인수공통 감염)", "group": "rec-dsp", "def": "사람과 동물에 함께 옮을 수 있는 감염.", "src": "WK04 강의 녹음② 1:46:24–1:46:51"},
    {"no": 139, "term": "HCD (Host Cell DNA)", "group": "rec-dsp", "def": "죽은 숙주세포가 터지며 나온 DNA 불순물(면역반응·돌연변이 위험).", "src": "WK04 강의 녹음② 1:56:00–1:56:46", "short": true, "answersExtra": ["숙주세포 DNA", "숙주 세포 DNA"]},
    {"no": 140, "term": "Endotoxin", "group": "rec-dsp", "def": "세균 세포벽에서 나와 열을 일으키는 독소 불순물(일반 원리).", "src": "WK04 강의 녹음② 1:54:15–1:57:03", "short": true, "answersExtra": ["내독소", "엔도톡신"]},
    {"no": 141, "term": "pI (등전점)", "group": "rec-dsp", "def": "단백질의 전체 전하가 0이 되는 pH — 항체는 약 7~8.", "src": "WK04 강의 녹음② 1:53:29–1:54:15, 1:57:18", "short": true, "answersExtra": ["pl", "등전점"]},
    {"no": 142, "term": "LRV (Log Reduction Value)", "group": "rec-dsp", "def": "바이러스 등이 줄어든 정도를 10의 거듭제곱(log)으로 나타낸 값.", "src": "WK04 강의 녹음② 2:09:15–2:10:17", "short": true, "answersExtra": ["로그 감소값", "로그 감소 값"]},
    {"no": 143, "term": "High conductivity (높은 전도도)", "group": "rec-dsp", "def": "염 농도가 높은 상태를 현업에서 부르는 말 — IEX 용출 조건.", "src": "WK04 강의 녹음② 1:59:45–2:01:18", "drop": true},
    {"no": 144, "term": "mS/cm", "group": "rec-dsp", "def": "Conductivity(염 농도)를 나타내는 단위.", "src": "WK04 강의 녹음② 2:01:23–2:01:56", "drop": true},
