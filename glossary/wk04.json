{
  "week": "WK04",
  "prefix": "tw04",
  "lecture": "WK04 PDF",
  "terms": [
    {"no": 1, "term": "Process-related impurity (공정 유래 불순물)", "group": "dsp", "def": "배지·HCP·DNA·엔도톡신처럼 공정에서 들어온 불순물(안전성↓).", "src": "WK04 PDF p.9 (Impurities)"},
    {"no": 2, "term": "Product-related impurity (제품 유래 불순물)", "group": "dsp", "def": "응집체·산화·잘못 접힌 단백질처럼 제품 자체가 변한 불순물(품질↓).", "src": "WK04 PDF p.9 (Impurities)"},
    {"no": 3, "term": "Precipitation (침전)", "group": "dsp", "def": "알코올·PEG 등을 넣어 목표 물질을 가라앉혀 나누는 1차 정제 방법.", "src": "WK04 PDF p.11 (Precipitation)"},
    {"no": 4, "term": "Centrifugation (원심분리)", "group": "dsp", "def": "빠르게 돌려 무거운 세포·찌꺼기를 가라앉혀 나누는 방법.", "src": "WK04 PDF p.10, p.12 (Centrifuge)"},
    {"no": 5, "term": "Continuous centrifuge (연속 원심분리기)", "group": "dsp", "def": "load·wash·discharge를 되풀이하며 쉬지 않고 돌리는 원심분리 장비(kSep).", "src": "WK04 PDF p.12 (Centrifuge)"},
    {"no": 6, "term": "Inclusion body (봉입체)", "group": "dsp", "def": "세균 안에서 잘못 접혀 뭉친 단백질 덩어리.", "src": "WK04 PDF p.14 (Case Study – r-Insulin)"},
    {"no": 7, "term": "Refolding (재접힘)", "group": "dsp", "def": "녹여 낸 단백질을 다시 올바른 구조로 접는 단계.", "src": "WK04 PDF p.14 (Case Study – r-Insulin)"},
    {"no": 8, "term": "Cell lysis (세포 파쇄)", "group": "dsp", "def": "세포 안에 만들어진 산물을 꺼내려고 세포를 깨는 것.", "src": "WK04 PDF p.13 (IB Process)"},
    {"no": 9, "term": "Fill & Finish (F&F)", "group": "dsp", "def": "제형화·최종 무균 여과·충전·캡핑으로 완제품을 만드는 마지막 공정.", "src": "WK04 PDF p.17 (F&F)"},
    {"no": 10, "term": "BFS (Blow Fill Seal)", "group": "dsp", "def": "용기를 성형하자마자 충전·밀봉까지 한 번에 하는 방식.", "src": "WK04 PDF p.17 (F&F)"},
    {"no": 11, "term": "Media mitigation (배지 오염 저감)", "group": "dsp", "def": "감마선·HTST·UV-C·멸균·여과로 배지의 오염 위험을 줄이는 것.", "src": "WK04 PDF p.16 (항체 정제 공정)"},
    {"no": 12, "term": "Filtration (여과)", "group": "basic", "def": "상(相)·크기가 다른 물질을 물리적·기계적으로 나누는 것.", "src": "WK04 PDF p.22 (여과는 어떻게 이루어지는가?)"},
    {"no": 13, "term": "Driving pressure difference (P1 − P2)", "group": "basic", "def": "필터 앞뒤 압력 차 — 이 차이가 유체를 움직인다.", "src": "WK04 PDF p.22 (구동 원리)"},
    {"no": 14, "term": "Clarification (정화)", "group": "basic", "def": "배양액 속 세포·세포 찌꺼기(수 µm 입자)를 필터로 걸러 내는 공정.", "src": "WK04 PDF p.23 (Filtration: Unit Operation)"},
    {"no": 15, "term": "Pre-filter (사전 여과)", "group": "basic", "def": "최종 필터 앞에서 큰 입자를 먼저 걸러 막힘을 줄이는 필터.", "src": "WK04 PDF p.23, p.39"},
    {"no": 16, "term": "Sterilizing-grade filter (제균 필터)", "group": "basic", "def": "세균 도전 시험에서 여과액이 무균으로 나온 0.2 µm 급 필터.", "src": "WK04 PDF p.24 (제균 Filter의 정의)"},
    {"no": 17, "term": "BCT (Bacteria Challenge Test)", "group": "basic", "def": "막 cm²당 10⁷개의 작은 세균을 걸러 여과액이 무균인지 보는 시험.", "src": "WK04 PDF p.24, p.121"},
    {"no": 18, "term": "Brevundimonas diminuta", "group": "basic", "def": "제균 필터 시험에 쓰는 아주 작은 세균(worst case).", "src": "WK04 PDF p.24 (Bacteria Challenge Test)"},
    {"no": 19, "term": "Filtrate (여과액)", "group": "basic", "def": "필터를 통과해 뒤로 나온 액체.", "src": "WK04 PDF p.43 (Membrane + Depth)"},
    {"no": 20, "term": "DEF (Dead-End Filtration)", "group": "mech", "def": "액체를 막에 수직으로 밀어 넣어 모두 통과시키는 여과.", "src": "WK04 PDF p.26 (Mechanism)"},
    {"no": 21, "term": "CFF / TFF (Crossflow·Tangential Flow Filtration)", "group": "mech", "def": "액체가 막 표면을 따라 흐르며 일부만 막을 지나가는 여과.", "src": "WK04 PDF p.26, p.85"},
    {"no": 22, "term": "Microfiltration (MF, 정밀여과)", "group": "mech", "def": "0.1~100 µm 구멍으로 세포·입자를 거르는 여과.", "src": "WK04 PDF p.32 (Size에 따른 분리)"},
    {"no": 23, "term": "Ultrafiltration (UF, 한외여과)", "group": "mech", "def": "nm 수준 구멍으로 단백질은 남기고 물·염은 빼는 여과.", "src": "WK04 PDF p.32 (Size에 따른 분리)"},
    {"no": 24, "term": "Nanofiltration (NF, 나노여과)", "group": "mech", "def": "2~5 nm 구멍의 여과 — 바이러스 여과도 여기에 속한다.", "src": "WK04 PDF p.32, p.40"},
    {"no": 25, "term": "Reverse osmosis (RO, 역삼투)", "group": "mech", "def": "가장 작은 막에 아주 높은 압력을 걸어 이온까지 거르는 여과.", "src": "WK04 PDF p.32 (Size에 따른 분리)"},
    {"no": 26, "term": "MWCO (Molecular Weight Cut-Off)", "group": "mech", "def": "막이 걸러 내는 분자 크기를 분자량(kDa)으로 나타낸 값.", "src": "WK04 PDF p.46 (Pore Size / MWCO)"},
    {"no": 27, "term": "Size exclusion (크기 배제)", "group": "mech", "def": "구멍보다 큰 것은 남기고 작은 것은 통과시키는 분리 원리.", "src": "WK04 PDF p.27, p.29"},
    {"no": 28, "term": "Membrane filter (멤브레인 필터)", "group": "material", "def": "얇은 막 표면에서 걸러, 압력이 높아도 입자가 뒤로 넘어가지 않는 필터.", "src": "WK04 PDF p.40 (Membrane Filter)"},
    {"no": 29, "term": "Depth filter (깊이 필터)", "group": "material", "def": "두꺼운 섬유층 안에 입자를 많이 붙잡지만 압력이 높으면 샐 수 있는 필터.", "src": "WK04 PDF p.41 (Depth filter)"},
    {"no": 30, "term": "Combination filter (Depth + Membrane)", "group": "material", "def": "깊이 필터층과 막을 합쳐 많이 잡으면서 확실히 거르는 필터.", "src": "WK04 PDF p.43"},
    {"no": 31, "term": "PES (Polyethersulfone)", "group": "material", "def": "제균 필터(Sartopore)에 많이 쓰는 합성 고분자 막 재질.", "src": "WK04 PDF p.34–35"},
    {"no": 32, "term": "PTFE (Polytetrafluoroethylene)", "group": "material", "def": "물을 밀어내는(소수성) 막 재질 — 기체·vent 필터에 쓴다.", "src": "WK04 PDF p.34, p.51"},
    {"no": 33, "term": "Cellulose acetate (CA)", "group": "material", "def": "셀룰로스 유도체로 만든 막 재질(Sartobran P).", "src": "WK04 PDF p.34–35"},
    {"no": 34, "term": "PP (Polypropylene)", "group": "material", "def": "깊이 필터에 쓰는 플라스틱 섬유 재질.", "src": "WK04 PDF p.34, p.42"},
    {"no": 35, "term": "Glass fiber (유리섬유)", "group": "material", "def": "깊이 필터에 쓰는 가는 유리 실 재질.", "src": "WK04 PDF p.34, p.42"},
    {"no": 36, "term": "Diatomaceous earth (규조토)", "group": "material", "def": "깊이 필터에 보조재로 넣어 미세 입자를 잘 붙잡게 하는 광물 가루.", "src": "WK04 PDF p.42 (Depth filter)"},
    {"no": 37, "term": "Asymmetric membrane (비대칭 막)", "group": "material", "def": "흐르는 방향으로 갈수록 구멍이 작아지는 막 구조.", "src": "WK04 PDF p.39 (Asymmetric PES Membranes)"},
    {"no": 38, "term": "Hydrophilic membrane (친수성 막)", "group": "material", "def": "물에 잘 젖는 막 — 액체 여과에 쓴다.", "src": "WK04 PDF p.40, p.124"},
    {"no": 39, "term": "Hydrophobic membrane (소수성 막)", "group": "material", "def": "물을 밀어내는 막 — 기체·vent 여과에 쓴다.", "src": "WK04 PDF p.40, p.51, p.124"},
    {"no": 40, "term": "Membrane casting (막 캐스팅)", "group": "material", "def": "고분자 용액을 얇게 펴 구멍 구조를 만들고 말려 막을 만드는 공정.", "src": "WK04 PDF p.36–38"},
    {"no": 41, "term": "Pore size (기공 크기)", "group": "pore", "def": "막 구멍의 크기(예: 0.2 µm) — 멤브레인 필터의 표기 방식.", "src": "WK04 PDF p.44 (Pore Size / Retention Rate)"},
    {"no": 42, "term": "Retention rate (보유율)", "group": "pore", "def": "정해진 크기의 입자를 걸러 내는 비율(%) — 깊이 필터의 표기 방식.", "src": "WK04 PDF p.44–45"},
    {"no": 43, "term": "Absolute rating (절대 등급)", "group": "pore", "def": "표시한 크기의 입자를 거의 모두(예: 99.98 % 이상) 걸러 내는 등급.", "src": "WK04 PDF p.44"},
    {"no": 44, "term": "Nominal rating (공칭 등급)", "group": "pore", "def": "표시한 크기의 입자를 일정 비율만 걸러 내는 등급.", "src": "WK04 PDF p.44"},
    {"no": 45, "term": "Beta ratio (β, 여과비)", "group": "pore", "def": "필터 앞 입자 수 ÷ 뒤 입자 수 — 클수록 잘 거른다.", "src": "WK04 PDF p.44"},
    {"no": 46, "term": "Vent filter (벤트 필터)", "group": "gas", "def": "탱크에 공기가 드나들게 하면서 오염은 막는 기체 필터.", "src": "WK04 PDF p.48–50"},
    {"no": 47, "term": "Tank collapse (탱크 찌그러짐)", "group": "gas", "def": "vent가 막혀 탱크 안이 진공이 되어 찌그러지는 사고.", "src": "WK04 PDF p.48–49"},
    {"no": 48, "term": "Double vent system (이중 vent)", "group": "gas", "def": "WFI 탱크에 vent 필터를 2개 달아 하나가 문제여도 대비하는 구성.", "src": "WK04 PDF p.58 (Double Vent System)"},
    {"no": 49, "term": "Heated vent housing (가열 vent 하우징)", "group": "gas", "def": "물기가 맺혀 vent 필터가 젖지 않도록 데우는 하우징.", "src": "WK04 PDF p.59, p.61"},
    {"no": 50, "term": "Sieve effect (체 효과)", "group": "gas", "def": "입자가 구멍보다 커서 필터 표면에 걸리는 기전.", "src": "WK04 PDF p.52 (Gas Filter Mechanism)"},
    {"no": 51, "term": "Impaction (관성 충돌)", "group": "gas", "def": "무거운 입자가 공기 흐름을 못 따라가 섬유에 부딪혀 잡히는 기전.", "src": "WK04 PDF p.53"},
    {"no": 52, "term": "Interception (차단)", "group": "gas", "def": "흐름을 따라가던 입자가 섬유 바로 옆을 지나다 닿아 잡히는 기전.", "src": "WK04 PDF p.53"},
    {"no": 53, "term": "Diffusion (Brownian motion, 확산)", "group": "gas", "def": "아주 작은 입자가 불규칙하게 움직이다 섬유에 닿아 잡히는 기전.", "src": "WK04 PDF p.54"},
    {"no": 54, "term": "Electrostatic interaction (정전기 인력)", "group": "gas", "def": "입자와 막의 서로 다른 전하가 끌어당겨 잡히는 기전.", "src": "WK04 PDF p.54"},
    {"no": 55, "term": "MPPS (Most Penetrating Particle Size)", "group": "gas", "def": "여러 포집 기전이 모두 약해 가장 잘 빠져나가는 입자 크기(약 0.2 µm).", "src": "WK04 PDF p.55"},
    {"no": 56, "term": "HEPA filter grade", "group": "gas", "def": "0.3 µm 입자를 99.95 % 이상 거르는 고성능 공기 필터 등급(H13·H14).", "src": "WK04 PDF p.57"},
    {"no": 57, "term": "Aerosol challenge test", "group": "gas", "def": "박테리오파지 같은 미세 입자를 공기에 실어 기체 필터 성능을 보는 시험.", "src": "WK04 PDF p.56"},
    {"no": 58, "term": "Filter sizing test", "group": "size", "def": "공정에 쓸 필터 면적을 정하려고 작은 필터로 미리 해 보는 시험.", "src": "WK04 PDF p.65 (What is Filter Sizing Test?)"},
    {"no": 59, "term": "Vmax (Constant pressure method)", "group": "size", "def": "일정 압력에서 유량이 끝점까지 줄 때까지의 최대 여과량(주로 멤브레인).", "src": "WK04 PDF p.66"},
    {"no": 60, "term": "Pmax (Constant flow method)", "group": "size", "def": "일정 유속에서 압력이 끝점에 이를 때까지의 최대 여과량(주로 깊이 필터).", "src": "WK04 PDF p.66"},
    {"no": 61, "term": "Tmax (Constant flow method)", "group": "size", "def": "일정 유속에서 탁도가 끝점에 이를 때까지의 최대 여과량.", "src": "WK04 PDF p.66"},
    {"no": 62, "term": "Flux (LMH)", "group": "size", "def": "막 1 m²를 1시간에 통과하는 양(L/m²/h).", "src": "WK04 PDF p.68, p.70"},
    {"no": 63, "term": "Filter capacity (L/m²)", "group": "size", "def": "막 1 m²가 처리할 수 있는 시료 양.", "src": "WK04 PDF p.68"},
    {"no": 64, "term": "Plugging (막힘)", "group": "size", "def": "입자가 쌓여 압력은 오르고 유량은 줄어드는 현상.", "src": "WK04 PDF p.64 (Filter가 막히면…)"},
    {"no": 65, "term": "Cartridge filter (카트리지 필터)", "group": "system", "def": "스테인리스 하우징에 끼워 쓰고 필터만 바꾸는 형태.", "src": "WK04 PDF p.72 (Cartridge and Capsule)"},
    {"no": 66, "term": "Capsule filter (캡슐 필터)", "group": "system", "def": "하우징과 필터가 한 몸인 일회용 형태.", "src": "WK04 PDF p.72 (Cartridge and Capsule)"},
    {"no": 67, "term": "Filter housing (필터 하우징)", "group": "system", "def": "필터를 담아 압력을 견디는 용기(주로 SS 316L).", "src": "WK04 PDF p.72, p.74–76"},
    {"no": 68, "term": "Pleated membrane (주름 막)", "group": "system", "def": "좁은 공간에 넓은 막 면적을 넣으려고 주름지게 접은 구조.", "src": "WK04 PDF p.73 (Filter의 구조)"},
    {"no": 69, "term": "Sanitary clamp / Ferrule", "group": "system", "def": "배관을 위생적으로 잇는 연결부 — 규격(DIN·ASME 등)마다 크기가 다르다.", "src": "WK04 PDF p.75"},
    {"no": 70, "term": "SS 316L (Stainless steel)", "group": "system", "def": "철에 크롬·니켈·몰리브덴을 더해 잘 녹슬지 않는 강철.", "src": "WK04 PDF p.76 (Filter Housing)"},
    {"no": 71, "term": "Peristaltic pump (연동 펌프)", "group": "system", "def": "튜브를 눌러 밀어 보내 시료와 닿지 않는 펌프(튜브 교체 필요).", "src": "WK04 PDF p.81 (Pump)"},
    {"no": 72, "term": "Diaphragm pump (다이어프램 펌프)", "group": "system", "def": "막을 움직여 보내는 펌프 — shear가 적지만 유량이 낮다.", "src": "WK04 PDF p.81 (Pump)"},
    {"no": 73, "term": "Rotary lobe pump (로터리 로브 펌프)", "group": "system", "def": "날개(로브) 두 개가 돌며 보내는 펌프 — CIP·SIP와 대규모에 맞다.", "src": "WK04 PDF p.81 (Pump)"},
    {"no": 74, "term": "Self-priming (자흡)", "group": "system", "def": "펌프가 스스로 액체를 빨아올릴 수 있는 성질.", "src": "WK04 PDF p.81 (Pump)"},
    {"no": 75, "term": "Pressurized transfer (가압 이송)", "group": "system", "def": "압축 기체로 탱크를 눌러 액체를 보내는 방식(대규모에 흔함).", "src": "WK04 PDF p.80 (Fluid Transfer)"},
    {"no": 76, "term": "Gravity transfer (중력 이송)", "group": "system", "def": "높이 차이만으로 액체를 보내는 방식(에너지는 안 들지만 느림).", "src": "WK04 PDF p.80 (Fluid Transfer)"},
    {"no": 77, "term": "Feed (TFF)", "group": "tff", "def": "TFF 막으로 들어가는 액체 흐름.", "src": "WK04 PDF p.86 (CFF System의 구성)"},
    {"no": 78, "term": "Retentate (TFF)", "group": "tff", "def": "막을 지나지 못하고 탱크로 돌아가는 쪽 — 목표 물질이 남는다.", "src": "WK04 PDF p.86 (CFF System의 구성)"},
    {"no": 79, "term": "Permeate (TFF)", "group": "tff", "def": "막을 지나 빠져나간 쪽 액체.", "src": "WK04 PDF p.86 (CFF System의 구성)"},
    {"no": 80, "term": "TMP (Transmembrane Pressure)", "group": "tff", "def": "막을 가로질러 걸리는 평균 압력 — 높이면 투과가 늘다 한계에 이른다.", "src": "WK04 PDF p.88, p.90"},
    {"no": 81, "term": "ΔP (Pfeed − Pretentate)", "group": "tff", "def": "TFF 막 입구와 출구의 압력 차 — 높이면 표면을 씻는 흐름이 는다.", "src": "WK04 PDF p.88, p.92"},
    {"no": 82, "term": "Crossflow rate (Recirculation rate)", "group": "tff", "def": "막 표면을 따라 retentate 쪽으로 흐르는 액체의 양.", "src": "WK04 PDF p.88"},
    {"no": 83, "term": "Gel layer (겔층)", "group": "tff", "def": "막 표면에 단백질이 몰려 생긴 층 — 투과를 막는다.", "src": "WK04 PDF p.91, p.108"},
    {"no": 84, "term": "Optimum TMP", "group": "tff", "def": "압력을 더 올려도 flux가 크게 늘지 않기 시작하는 지점.", "src": "WK04 PDF p.91, p.93"},
    {"no": 85, "term": "Concentration (농축)", "group": "tff", "def": "용매를 빼서 목표 물질의 농도를 높이는 것.", "src": "WK04 PDF p.100, p.103"},
    {"no": 86, "term": "Diafiltration (다이아필트레이션)", "group": "tff", "def": "새 버퍼를 넣고 빼기를 되풀이해 기존 버퍼를 바꾸는 것.", "src": "WK04 PDF p.100, p.103"},
    {"no": 87, "term": "Continuous diafiltration (연속 DF)", "group": "tff", "def": "빠지는 만큼 새 버퍼를 계속 넣어 부피를 일정하게 두는 방식.", "src": "WK04 PDF p.104"},
    {"no": 88, "term": "Batch diafiltration (회분 DF)", "group": "tff", "def": "버퍼를 한 번에 넣고 다시 농축하기를 되풀이하는 방식.", "src": "WK04 PDF p.104"},
    {"no": 89, "term": "Cassette (flat sheet module)", "group": "tff", "def": "막 sheet를 겹겹이 쌓은 TFF 모듈 — holder가 필요하다.", "src": "WK04 PDF p.95–96"},
    {"no": 90, "term": "Hollow fiber module", "group": "tff", "def": "속 빈 섬유 다발로 된 TFF 모듈 — holder 없이 쓴다.", "src": "WK04 PDF p.95–96"},
    {"no": 91, "term": "Spiral-wound module", "group": "tff", "def": "막을 김밥처럼 말아 감은 TFF 모듈.", "src": "WK04 PDF p.95"},
    {"no": 92, "term": "Fouling (파울링)", "group": "tff", "def": "단백질·지방 등이 막에 달라붙어 성능이 떨어지는 현상.", "src": "WK04 PDF p.108–109"},
    {"no": 93, "term": "CWF (Clean Water Flux)", "group": "tff", "def": "깨끗한 물이 막을 통과하는 flux — 카세트 상태·세척 결과 확인용.", "src": "WK04 PDF p.111"},
    {"no": 94, "term": "NWP (Normalized Water Permeability)", "group": "tff", "def": "물 투과값을 TMP·막 면적·온도로 보정한 값.", "src": "WK04 PDF p.112"},
    {"no": 95, "term": "Membrane life cycle (막 수명)", "group": "tff", "def": "물 투과도·무결성·품질·용출물을 보고 막을 몇 번 다시 쓸지 정한 것.", "src": "WK04 PDF p.110"},
    {"no": 96, "term": "System hold-up volume", "group": "tff", "def": "장비 배관 안에 남는 액체 부피 — TFF 운전 전에 먼저 정한다.", "src": "WK04 PDF p.106 (Process Flow)"},
    {"no": 97, "term": "Filter integrity test (필터 무결성 시험)", "group": "it", "def": "필터가 손상 없이 제 성능을 내는지 확인하는 시험.", "src": "WK04 PDF p.116–117"},
    {"no": 98, "term": "Destructive test (파괴검사)", "group": "it", "def": "제조사가 하는 시험으로, 끝나면 필터를 다시 쓸 수 없다(BCT 등).", "src": "WK04 PDF p.118"},
    {"no": 99, "term": "Non-destructive test (비파괴검사)", "group": "it", "def": "사용자가 하는 간접 시험으로, 필터를 다시 쓸 수 있다.", "src": "WK04 PDF p.118"},
    {"no": 100, "term": "Bubble point test (기포점 시험)", "group": "it", "def": "젖은 막에 압력을 올려 기포가 줄지어 나오는 압력을 재는 시험.", "src": "WK04 PDF p.125–126"},
    {"no": 101, "term": "Diffusion test (확산 시험)", "group": "it", "def": "기포점보다 낮은 압력(약 80 %)에서 막을 통해 퍼져 나오는 기체량을 재는 시험.", "src": "WK04 PDF p.127, p.131"},
    {"no": 102, "term": "Pressure drop test (압력 강하 시험)", "group": "it", "def": "확산 원리로, 필터 위쪽(상류) 압력이 떨어지는 정도를 재는 시험.", "src": "WK04 PDF p.135–136"},
    {"no": 103, "term": "Water intrusion test (WIT)", "group": "it", "def": "소수성 필터에 물을 밀어 넣어 구멍으로 스며드는 물의 양을 재는 시험.", "src": "WK04 PDF p.137–139"},
    {"no": 104, "term": "Wetting agent (적심 액)", "group": "it", "def": "무결성 시험 전에 막 구멍을 채우는 액체(친수성은 물, 소수성은 IPA/물).", "src": "WK04 PDF p.134"},
    {"no": 105, "term": "Wetting angle (접촉각)", "group": "it", "def": "액체가 표면에 닿는 각도 — 90° 미만이면 잘 젖는다.", "src": "WK04 PDF p.125, p.128"},
    {"no": 106, "term": "Surface tension (표면장력)", "group": "it", "def": "액체 표면이 줄어들려는 힘 — 클수록 기포점 압력이 높다.", "src": "WK04 PDF p.125, p.134"},
    {"no": 107, "term": "Min. bubble point", "group": "it", "def": "필터가 무결하다고 보는 최소 기포점 압력(합격 기준).", "src": "WK04 PDF p.151"},
    {"no": 108, "term": "Max. bubble point", "group": "it", "def": "합격한 필터가 손상되지 않게 시험을 멈추는 압력(무결성과 직접 관계없음).", "src": "WK04 PDF p.151"},
    {"no": 109, "term": "IT test limit (무결성 합격 기준)", "group": "it", "def": "제조사가 BCT와 기포점·확산 결과를 묶어 정해 주는 합격 기준.", "src": "WK04 PDF p.119–120"},
    {"no": 110, "term": "Reference wetting fluid", "group": "it", "def": "물로 잘 안 젖을 때 쓰는 낮은 표면장력 액체(IPA/물)로 하는 재시험용 액.", "src": "WK04 PDF p.152, p.156"},
    {"no": 111, "term": "PDA TR 26", "group": "it", "def": "제균 필터 무결성 시험과 실패 시 조치 절차를 정리한 기술 보고서.", "src": "WK04 PDF p.122, p.152–153"},
    {"no": 112, "term": "Redundant filtration (이중 제균 여과)", "group": "it", "def": "첫 제균 필터가 실패할 때를 대비해 두 번째 제균 필터를 연달아 두는 것.", "src": "WK04 PDF p.157"},
    {"no": 113, "term": "PUPSIT (Pre-Use Post-Sterilization Integrity Test)", "group": "it", "def": "멸균한 뒤, 쓰기 직전에 하는 제균 필터 무결성 시험.", "src": "WK04 PDF p.17, p.158"}
  ]
}
