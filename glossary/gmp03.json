{
  "week": "GMP03",
  "prefix": "tg03",
  "lecture": "03 Isolator PDF",
  "matchSealed": 48,
  "terms": [
    {"no": 1, "term": "구조적 차단 (Isolator 원리)", "group": "principle", "def": "벽으로 작업자와 Grade A 공간을 완전히 나눠 구조로 오염을 막는 방식.", "src": "03 Isolator & Qualification PDF p.3"},
    {"no": 2, "term": "확률적 관리 (Clean room 방식)", "group": "principle", "def": "작업자가 같은 공간에서 무균복과 행동 규칙으로 오염을 줄이는 방식.", "src": "03 Isolator & Qualification PDF p.3"},
    {"no": 3, "term": "Leak integrity (기밀성)", "group": "principle", "def": "챔버와 글러브가 새지 않는 상태.", "src": "03 Isolator & Qualification PDF p.3"},
    {"no": 4, "term": "압력 계위 (Pressure cascade)", "group": "chamber", "def": "청정한 곳일수록 압력을 높여 공기가 깨끗한 쪽에서 덜 깨끗한 쪽으로 흐르게 하는 배치.", "src": "03 Isolator & Qualification PDF p.4"},
    {"no": 5, "term": "Main chamber", "group": "chamber", "def": "실제 무균 작업이 이루어지는 Grade A 작업 공간.", "src": "03 Isolator & Qualification PDF p.4"},
    {"no": 6, "term": "Incoming airlock", "group": "chamber", "def": "들어오는 자재를 제염하고 대기시키는 완충 공간.", "src": "03 Isolator & Qualification PDF p.4"},
    {"no": 7, "term": "Outgoing airlock", "group": "chamber", "def": "다 쓴 자재와 폐기물을 내보내는 구간.", "src": "03 Isolator & Qualification PDF p.4"},
    {"no": 8, "term": "Preparation (VHP 1단계)", "group": "cycle", "def": "검증된 조건으로 제염을 준비하는 VHP 첫 단계.", "src": "03 Isolator & Qualification PDF p.7"},
    {"no": 9, "term": "Conditioning (VHP 2단계)", "group": "cycle", "def": "H₂O₂를 넣어 목표 농도까지 올리는 단계.", "src": "03 Isolator & Qualification PDF p.7"},
    {"no": 10, "term": "Decontamination (VHP 3단계)", "group": "cycle", "def": "목표 농도를 정해진 시간 동안 유지해 미생물을 죽이는 단계.", "src": "03 Isolator & Qualification PDF p.7"},
    {"no": 11, "term": "Aeration (VHP 4단계)", "group": "cycle", "def": "H₂O₂를 빼서 남은 농도를 안전 기준 아래로 낮추는 단계.", "src": "03 Isolator & Qualification PDF p.7, p.17"},
    {"no": 12, "term": "Dwell time (접촉 시간)", "group": "cond", "def": "목표 농도의 H₂O₂가 표면에 머무는 시간.", "src": "03 Isolator & Qualification PDF p.7"},
    {"no": 13, "term": "Distribution (분포)", "group": "cond", "def": "H₂O₂가 챔버 전체 표면에 고르게 퍼지게 하는 조건.", "src": "03 Isolator & Qualification PDF p.7"},
    {"no": 14, "term": "Dosing rate (주입 속도)", "group": "cond", "def": "H₂O₂ 용액을 넣는 속도(목표 농도 유지용).", "src": "03 Isolator & Qualification PDF p.7"},
    {"no": 15, "term": "Hydroxyl radical (·OH)", "group": "kill", "def": "H₂O₂가 분해되며 생겨 세포막·단백질·핵산을 산화시키는 강한 라디칼.", "src": "03 Isolator & Qualification PDF p.8"},
    {"no": 16, "term": "아포 (Spore)", "group": "kill", "def": "외피가 두꺼워 라디칼이 늦게 들어가는, 저항성이 매우 높은 미생물 형태.", "src": "03 Isolator & Qualification PDF p.8"},
    {"no": 17, "term": "Occluded surface (가려진 표면)", "group": "load", "def": "포개진 면·나사 틈처럼 H₂O₂ 증기가 닿지 않는 표면.", "src": "03 Isolator & Qualification PDF p.8–9"},
    {"no": 18, "term": "Load pattern (적재 패턴)", "group": "load", "def": "제염할 물건을 챔버 안에 어떤 위치·간격으로 놓을지 정한 것.", "src": "03 Isolator & Qualification PDF p.11"},
    {"no": 19, "term": "Maximum load", "group": "load", "def": "허용되는 가장 많은 적재 — 검증의 worst case.", "src": "03 Isolator & Qualification PDF p.11"},
    {"no": 20, "term": "Minimum / Empty load", "group": "load", "def": "적재가 거의 없어 기류가 지나치게 센 조건.", "src": "03 Isolator & Qualification PDF p.11"},
    {"no": 21, "term": "흡착성 재질", "group": "load", "def": "H₂O₂를 빨아들였다 천천히 내보내 aeration을 길게 만드는 재질.", "src": "03 Isolator & Qualification PDF p.11, p.17"},
    {"no": 22, "term": "BI (Biological Indicator)", "group": "ind", "def": "내성 포자를 올린 지표 — 살았는지 죽었는지로 제염 효과를 직접 입증한다.", "src": "03 Isolator & Qualification PDF p.12, p.14"},
    {"no": 23, "term": "CI (Chemical Indicator)", "group": "ind", "def": "H₂O₂에 노출됐는지를 색 변화로 보여 주는 보조 지표.", "src": "03 Isolator & Qualification PDF p.12, p.14"},
    {"no": 24, "term": "EI (Enzyme Indicator)", "group": "ind", "def": "효소 활성으로 log 감소를 추정하는 간접 지표(최종 판정에는 안 씀).", "src": "03 Isolator & Qualification PDF (BI·CI·EI 비교)"},
    {"no": 25, "term": "Geobacillus stearothermophilus", "group": "ind", "def": "H₂O₂·습열 제염 검증용 BI에 쓰는 내성 포자 균주.", "src": "03 Isolator & Qualification PDF p.14"},
    {"no": 26, "term": "Population (BI 포자 수)", "group": "ind", "def": "BI 하나에 올린 포자 수(6 log 감소를 보이려면 10⁶ 이상).", "src": "03 Isolator & Qualification PDF p.12, p.14"},
    {"no": 27, "term": "D-value", "group": "ind", "def": "미생물 수를 10분의 1로 줄이는 데 걸리는 시간.", "src": "03 Isolator & Qualification PDF p.12"},
    {"no": 28, "term": "SLR (Spore Log Reduction)", "group": "ind", "def": "제염으로 줄어든 포자 수를 log로 나타낸 값(6 log 이상 필요).", "src": "03 Isolator & Qualification PDF p.14"},
    {"no": 29, "term": "Steel disk carrier", "group": "ind", "def": "포자를 올린 평평한 금속 원판(H₂O₂가 스며들지 않음).", "src": "03 Isolator & Qualification PDF (BI 담체)"},
    {"no": 30, "term": "Total kill time", "group": "dev", "def": "모든 BI가 죽는 최소 주입량과 노출 시간.", "src": "03 Isolator & Qualification PDF p.10, p.14"},
    {"no": 31, "term": "Fractional study", "group": "dev", "def": "노출 시간을 나눠 BI 일부만 죽는 구간까지 확인하는 시험.", "src": "03 Isolator & Qualification PDF p.7, p.14"},
    {"no": 32, "term": "Temperature & humidity mapping", "group": "dev", "def": "챔버 안 온도·습도 분포를 재서 응축 위험을 찾는 시험.", "src": "03 Isolator & Qualification PDF p.10"},
    {"no": 33, "term": "CI mapping", "group": "dev", "def": "챔버 곳곳에 CI를 두어 H₂O₂가 고르게 닿는지 보는 시험.", "src": "03 Isolator & Qualification PDF p.10"},
    {"no": 34, "term": "Cycle development (CD)", "group": "qual", "def": "시험을 통해 적재·주입량·시간 같은 운전 조건을 정하는 단계.", "src": "03 Isolator & Qualification PDF p.10, p.13"},
    {"no": 35, "term": "URS / DQ (아이솔레이터)", "group": "qual", "def": "설계 요구사항을 정하고 설계가 이를 만족하는지 확인하는 첫 단계.", "src": "03 Isolator & Qualification PDF p.13"},
    {"no": 36, "term": "IQ (Installation Qualification)", "group": "qual", "def": "설치 상태가 사양·도면과 맞는지 확인하는 적격성평가.", "src": "03 Isolator & Qualification PDF p.13"},
    {"no": 37, "term": "OQ (Operational Qualification)", "group": "qual", "def": "압력·기류·알람 등이 의도대로 작동하는지 확인하는 적격성평가.", "src": "03 Isolator & Qualification PDF p.13"},
    {"no": 38, "term": "MBQ (Microbiological Qualification, PQ)", "group": "qual", "def": "worst case 적재에서 BI가 모두 죽고 6 log 감소를 입증하는 미생물 성능 평가.", "src": "03 Isolator & Qualification PDF p.13"},
    {"no": 39, "term": "PRQ (Periodic Requalification)", "group": "qual", "def": "제염 성능이 계속 유지되는지 매년 다시 확인하는 단계.", "src": "03 Isolator & Qualification PDF p.13"},
    {"no": 40, "term": "Edges of enclosure", "group": "loc", "def": "챔버 모서리·코너처럼 기류가 약한 경계부 위치.", "src": "03 Isolator & Qualification PDF p.12"},
    {"no": 41, "term": "Airflow challenging areas", "group": "loc", "def": "문 뒤·구조물 뒤처럼 기류가 잘 안 닿는 가려진 위치.", "src": "03 Isolator & Qualification PDF p.12"},
    {"no": 42, "term": "Process critical positions", "group": "loc", "def": "작업 표면·개구부처럼 실제 무균 작업이 일어나는 위치.", "src": "03 Isolator & Qualification PDF p.12"},
    {"no": 43, "term": "Glove visual inspection", "group": "glove", "def": "글러브를 당겨 손상을 눈으로 확인하는 점검.", "src": "03 Isolator & Qualification PDF p.16"},
    {"no": 44, "term": "Pressure decay test", "group": "glove", "def": "글러브 안에 압력을 넣고 떨어지는 정도로 누설을 재는 시험.", "src": "03 Isolator & Qualification PDF p.16"},
    {"no": 45, "term": "Leak rate (누설률)", "group": "glove", "def": "단위 시간에 새어 나가는 양.", "src": "03 Isolator & Qualification PDF p.16"},
    {"no": 46, "term": "Audit trail", "group": "glove", "def": "전자 기록을 언제 누가 어떻게 만들고 바꿨는지 자동으로 남는 이력.", "src": "03 Isolator & Qualification PDF p.16"},
    {"no": 47, "term": "잔류 H₂O₂ 허용 기준", "group": "cycle", "def": "aeration 뒤 챔버에 남아도 되는 과산화수소 농도 한도.", "src": "03 Isolator & Qualification PDF p.10, p.17"},
    {"no": 48, "term": "Sterility testing isolator", "group": "principle", "def": "QC에서 무균시험을 하는 아이솔레이터(잔류 H₂O₂가 위음성을 낼 수 있음).", "src": "03 Isolator & Qualification PDF p.2, p.17"},
    {"no": 49, "term": "Disinfection (소독)", "group": "rec-ster", "def": "미생물을 줄이는 수준(약 3 log 감소)의 처리.", "src": "03 Isolator & Qualification 강의 녹음 17:56–18:14"},
    {"no": 50, "term": "Sterilization (멸균)", "group": "rec-ster", "def": "미생물을 6 log 이상 줄이는 수준의 처리.", "src": "03 Isolator & Qualification 강의 녹음 12:55–13:18, 17:56–18:14"},
    {"no": 51, "term": "Steam sterilization (스팀 멸균)", "group": "rec-ster", "def": "증기가 물건 안쪽·튜브 속까지 스며들어 멸균하는 방식.", "src": "03 Isolator & Qualification 강의 녹음 17:38–19:57"},
    {"no": 52, "term": "Paper strip BI (종이형 BI)", "group": "rec-ster", "def": "종이에 포자를 올린 BI — 주로 스팀 멸균기 검증용.", "src": "03 Isolator & Qualification 강의 녹음 33:49–35:08"},
    {"no": 53, "term": "Ampoule BI (앰플형 BI)", "group": "rec-ster", "def": "액체 안에 넣어 함께 멸균하는 BI — 액체 멸균 검증용.", "src": "03 Isolator & Qualification 강의 녹음 34:19–34:35"},
    {"no": 54, "term": "Rogue BI (로그 BI)", "group": "rec-ster", "def": "품질이 고르지 않아 다른 BI와 달리 살아남는 예외적인 BI.", "src": "03 Isolator & Qualification 강의 녹음 39:00–39:23"},
    {"no": 55, "term": "SOP (Standard Operating Procedure)", "group": "rec-ops", "def": "규제 가이드라인에 맞춰 회사가 정한 작업 절차 문서.", "src": "03 Isolator & Qualification 강의 녹음 09:24–09:44"},
    {"no": 56, "term": "GDP (Good Documentation Practice)", "group": "rec-ops", "def": "모든 작업을 바로·정확히 기록하는 원칙 — 기록이 없으면 안 한 것.", "src": "03 Isolator & Qualification 강의 녹음 27:52–28:06"},
    {"no": 57, "term": "Glove port (글러브 포트)", "group": "rec-ops", "def": "밀폐를 유지한 채 손을 넣어 개입할 수 있게 한 장갑 구멍.", "src": "03 Isolator & Qualification 강의 녹음 08:04–08:14, 10:45–10:57"},
    {"no": 58, "term": "Inherent intervention (고유 개입)", "group": "rec-ops", "def": "바이알 걸림처럼 늘 생기는 개입 — 미리 등록해 APS로 검증한다.", "src": "03 Isolator & Qualification 강의 녹음 08:14–09:07"},
    {"no": 59, "term": "C&Q (Commissioning & Qualification)", "group": "rec-ops", "def": "설비가 설계대로 설치·작동함을 확인하고 문서로 남기는 활동(ISPE 가이드).", "src": "03 Isolator & Qualification 강의 녹음 36:30–37:20"},
    {"no": 60, "term": "Chamber leak test (챔버 누설 시험)", "group": "rec-ops", "def": "제염 전에 챔버가 새지 않고 밀폐됐는지 확인하는 시험.", "src": "03 Isolator & Qualification 강의 녹음 14:06–15:22"},
    {"no": 61, "term": "Bracketing (브라케팅)", "group": "rec-ops", "def": "가장 나쁜 양 끝 조건(최대·최소)을 검증해 그 사이를 대표하는 방법.", "src": "03 Isolator & Qualification 강의 녹음 25:19–25:43, 29:51"}
  ]
}
