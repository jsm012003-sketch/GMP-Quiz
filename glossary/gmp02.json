  "lecture": "02 RABS & APS PDF",
  "terms": [
    {"no": 1, "term": "RABS (Restricted Access Barrier System)", "group": "barrier", "def": "차단벽과 한 방향 기류로 Grade A 충전 구역을 작업자와 떼어 놓는 시스템.", "src": "02 RABS & APS PDF p.4 (RABS의 정의와 목적)"},
    {"no": 2, "term": "Open RABS", "group": "barrier", "def": "작업 중 예외적으로 문을 열 수 있고 내부 공기를 주변실로 내보내는 차단 방식.", "src": "02 RABS & APS PDF p.8"},
    {"no": 3, "term": "Closed RABS", "group": "barrier", "def": "작업 중 완전히 닫아 두고 글러브포트·밀폐 이송만 쓰는 차단 방식.", "src": "02 RABS & APS PDF p.8"},
    {"no": 4, "term": "Isolator (아이솔레이터)", "group": "barrier", "def": "완전 밀폐와 자동 제균(VHP)으로 내부를 Grade A로 유지하는 차단 설비.", "src": "02 RABS & APS PDF p.9–10"},
    {"no": 5, "term": "기존 클린룸 (Conventional cleanroom)", "group": "barrier", "def": "차단벽 없이 무균복만으로 작업자와 공정을 나누는 개방형 무균 환경.", "src": "02 RABS & APS PDF p.9–10"},
    {"no": 6, "term": "글러브포트 (Glove port)", "group": "part", "def": "벽에 달린 장갑으로, 벽을 열지 않고 안쪽을 조작하게 하는 장치.", "src": "02 RABS & APS PDF p.5–7"},
    {"no": 7, "term": "HEPA 필터", "group": "part", "def": "아주 작은 입자까지 걸러 깨끗한 공기를 보내는 고성능 공기 필터.", "src": "02 RABS & APS PDF p.5"},
    {"no": 8, "term": "단일방향 기류 (Unidirectional airflow)", "group": "part", "def": "공기가 한 방향·일정 속도로 흘러 오염 입자를 밖으로 쓸어내는 흐름.", "src": "02 RABS & APS PDF p.5"},
    {"no": 9, "term": "First air", "group": "part", "def": "HEPA에서 나와 다른 곳을 거치지 않고 제품에 처음 닿는 깨끗한 공기.", "src": "02 RABS & APS PDF p.22 (Intervention 사례 ④)"},
    {"no": 10, "term": "RTP (Rapid Transfer Port)", "group": "part", "def": "두 문이 맞물려 열려 바깥 공기 없이 자재를 넣는 이송 포트.", "src": "02 RABS & APS PDF p.7–8", "drop": true},
    {"no": 11, "term": "스모크 스터디 (Smoke study)", "group": "part", "def": "연기로 공기 흐름을 눈으로 확인하는 시험(APS 전에 필수).", "src": "02 RABS & APS PDF p.7, p.11"},
    {"no": 12, "term": "VHP (Vaporized Hydrogen Peroxide)", "group": "part", "def": "과산화수소 증기로 밀폐 공간 안쪽 표면을 자동 제염하는 방법.", "src": "02 RABS & APS PDF p.7, p.9"},
    {"no": 13, "term": "CCS (Contamination Control Strategy)", "group": "reg", "def": "시설·설비·사람·공정 전체의 오염 위험과 관리 방법을 묶은 오염관리전략.", "src": "02 RABS & APS PDF p.3, p.9"},
    {"no": 14, "term": "EU GMP Annex 1", "group": "reg", "def": "무균 의약품 제조에 관한 EU GMP 부속서.", "src": "02 RABS & APS PDF p.3, p.11, p.19"},
    {"no": 15, "term": "ISO 13408-1", "group": "reg", "def": "무균 공정(Aseptic processing)의 정의를 정한 국제 표준.", "src": "02 RABS & APS PDF p.11", "drop": true},
    {"no": 16, "term": "PDA TR22", "group": "reg", "def": "'APS는 무균 공정을 평가하는 하나의 도구일 뿐'이라고 한 기술 보고서.", "src": "02 RABS & APS PDF p.13", "drop": true},
    {"no": 17, "term": "APS (Aseptic Process Simulation)", "group": "aps", "def": "제품 대신 배지로 무균 제조 공정 전체를 똑같이 해 보는 검증.", "src": "02 RABS & APS PDF p.11"},
    {"no": 18, "term": "SCDM (Soybean-Casein Digest Medium)", "group": "aps", "def": "여러 미생물이 잘 자라 APS에 쓰는 배지.", "src": "02 RABS & APS PDF p.15"},
    {"no": 19, "term": "GPT (Growth Promotion Test)", "group": "aps", "def": "APS 배지가 실제로 미생물을 키울 수 있는지 확인하는 시험.", "src": "02 RABS & APS PDF p.15, p.19"},
    {"no": 20, "term": "2단계 배양 (APS incubation)", "group": "aps", "def": "배지 용기를 낮은 온도 7일, 높은 온도 7일 배양해 세균·진균을 모두 찾는 조건.", "src": "02 RABS & APS PDF p.12, p.15"},
    {"no": 21, "term": "Initial APS", "group": "aps", "def": "새 라인이나 큰 변경 뒤 하는 첫 검증(연속 3회 성공 필요).", "src": "02 RABS & APS PDF p.12, p.14"},
    {"no": 22, "term": "Routine APS", "group": "aps", "def": "6개월마다 정기적으로 반복하는 APS.", "src": "02 RABS & APS PDF p.12, p.14"},
    {"no": 23, "term": "Zero growth (APS 판정 기준)", "group": "aps", "def": "배지 용기 중 하나라도 오염되면 실패로 보는 APS 합격 기준.", "src": "02 RABS & APS PDF p.19 (Annex 1, 9.46)"},
    {"no": 24, "term": "100 % 육안 검사 (APS)", "group": "aps", "def": "배양 후 모든 용기를 훈련된 검사자가 눈으로 확인하는 것.", "src": "02 RABS & APS PDF p.15, p.19", "drop": true},
    {"no": 25, "term": "APS Holistic approach", "group": "aps", "def": "무균성은 APS 하나가 아니라 시설·청소·EM·교육 등 전체 관리로 확보된다는 관점.", "src": "02 RABS & APS PDF p.13", "drop": true},
    {"no": 26, "term": "Intervention (간섭)", "group": "itv", "def": "무균 공정 지역에 영향을 주는 의도적 조작(대부분 사람이 함).", "src": "02 RABS & APS PDF p.17"},
    {"no": 27, "term": "Inherent intervention (일상적 간섭)", "group": "itv", "def": "장비 셋업·마개 보충처럼 공정 중 정상적으로 생기는 조작.", "src": "02 RABS & APS PDF p.17"},
    {"no": 28, "term": "Corrective intervention (조치 간섭)", "group": "itv", "def": "용기 파손·마개 걸림처럼 문제에 대응해 드물게 하는 조작.", "src": "02 RABS & APS PDF p.17"},
    {"no": 29, "term": "Worst case (최악 조건)", "group": "design", "def": "오염 위험이 가장 큰 조건 — 여기서 통과하면 쉬운 조건도 보증된다.", "src": "02 RABS & APS PDF p.12, p.16, p.24"},
    {"no": 30, "term": "Bracketing (브래킷팅)", "group": "design", "def": "양 끝 조건(가장 큰 것·작은 것)만 시험해 그 사이를 대표하게 하는 설계.", "src": "02 RABS & APS PDF p.24"},
    {"no": 31, "term": "Line speed (VPM)", "group": "design", "def": "분당 충전하는 바이알 수.", "src": "02 RABS & APS PDF p.14, p.24–25", "drop": true},
    {"no": 32, "term": "H/D 비 (용기 안정성)", "group": "design", "def": "용기 높이와 지름의 비 — 클수록 잘 쓰러진다.", "src": "02 RABS & APS PDF p.24", "drop": true},
    {"no": 33, "term": "APS 충전량 (Fill volume)", "group": "design", "def": "용기·마개 안쪽 면이 배지에 닿을 만큼 정하는 APS 배지 양.", "src": "02 RABS & APS PDF p.14", "drop": true},
    {"no": 34, "term": "근본원인 조사 (Root cause investigation)", "group": "fail", "def": "문제가 생겼을 때 가장 가능성 높은 원인을 밝히는 첫 조치.", "src": "02 RABS & APS PDF p.19"},
    {"no": 35, "term": "시정조치 (Corrective action)", "group": "fail", "def": "밝혀낸 원인을 없애기 위해 실행하는 조치.", "src": "02 RABS & APS PDF p.19"},
    {"no": 36, "term": "반복 APS (재검증)", "group": "fail", "def": "실패 뒤 공정이 관리 상태임을 다시 보이려고 하는 APS.", "src": "02 RABS & APS PDF p.15, p.19", "drop": true},
    {"no": 37, "term": "재자격 (Requalification of operator)", "group": "fail", "def": "작업자가 원인일 때 무균 작업을 막고 재훈련 후 다시 자격을 주는 것.", "src": "02 RABS & APS PDF p.19", "drop": true},
    {"no": 38, "term": "균 동정 (Identification)", "group": "fail", "def": "검출된 미생물이 무엇인지 확인해 오염 경로를 추적하는 조사.", "src": "02 RABS & APS PDF p.19", "drop": true},
    {"no": 39, "term": "Settle plate (낙하균 배지)", "group": "env", "def": "열어 두고 떨어지는 미생물을 받는 배지 접시.", "src": "02 RABS & APS PDF p.21 (Intervention 사례 ②)"},
    {"no": 40, "term": "Viable / Non-viable monitoring", "group": "env", "def": "살아 있는 미생물과 일반 입자를 나눠 재는 환경모니터링.", "src": "02 RABS & APS PDF p.13"},
    {"no": 41, "term": "SOP / WI", "group": "env", "def": "누가 해도 같은 방법으로 하도록 절차를 문서로 정한 것.", "src": "02 RABS & APS PDF p.13, p.23"},
    {"no": 42, "term": "오버스필 (Overspill)", "group": "part", "def": "Open RABS 안쪽 공기가 양압으로 주변실로 넘쳐 나가는 배기 방식.", "src": "02 RABS & APS PDF p.5", "drop": true}
  ]
}
